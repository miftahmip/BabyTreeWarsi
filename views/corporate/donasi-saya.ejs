<% layout('layouts/corporate') %>

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
  :root {
    --green-deep:   #1a4731;
    --green-mid:    #2d6a4f;
    --green-bright: #40916c;
    --green-light:  #74c69d;
    --green-pale:   #d8f3dc;
    --green-ghost:  #f0faf4;
    --brown-mid:    #7d5a3c;
    --brown-light:  #c9a87c;
    --cream:        #fdf8f0;
  }

  .ds-page {
    padding: 32px 32px 48px;
    background: var(--cream);
    min-height: 100vh;
    font-family: 'DM Sans', sans-serif;
    max-width: 980px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* ── HEADER ── */
  .ds-header {
    margin-bottom: 32px;
  }

  .ds-header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--green-bright);
    margin-bottom: 10px;
  }

  .ds-header-eyebrow::before {
    content: '';
    width: 16px; height: 2px;
    background: var(--green-bright);
    border-radius: 2px;
  }

  .ds-header-title {
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    color: var(--green-deep);
    line-height: 1.15;
    margin-bottom: 6px;
  }

  .ds-header-sub {
    font-size: 13.5px;
    color: #8fac9c;
    font-weight: 400;
  }

  /* ── SUMMARY ROW ── */
  .ds-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 40px;
  }

  .ds-summary-card {
    background: white;
    border: 1px solid #dceee3;
    border-radius: 14px;
    padding: 20px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform .18s, box-shadow .18s;
  }

  .ds-summary-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(26,71,49,.07);
  }

  .ds-summary-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ds-summary-icon.tree   { background: linear-gradient(135deg, #52b788, #1a4731); }
  .ds-summary-icon.money  { background: linear-gradient(135deg, #c9a87c, #7d5a3c); }
  .ds-summary-icon.alert  { background: linear-gradient(135deg, #ffca28, #f57f17); }

  .ds-summary-label {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: #9abfad;
    margin-bottom: 4px;
  }

  .ds-summary-value {
    font-family: 'DM Serif Display', serif;
    font-size: 1.65rem;
    color: var(--green-deep);
    line-height: 1;
  }

  /* ── SECTION ── */
  .ds-section {
    margin-bottom: 36px;
  }

  .ds-section-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 16px;
  }

  .ds-section-header h3 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--green-deep);
    margin: 0;
  }

  .ds-section-sub {
    font-size: 12.5px;
    color: #9abfad;
    font-weight: 400;
  }

  /* ── LIST ── */
  .ds-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ds-card {
    background: white;
    border: 1px solid #dceee3;
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow .2s, transform .2s;
  }

  .ds-card:hover {
    box-shadow: 0 10px 28px rgba(26,71,49,.09);
    transform: translateY(-2px);
  }

  .ds-card-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 22px;
  }

  /* Icon pohon di kiri card, gantikan strip polos */
  .ds-card-icon {
    width: 48px; height: 48px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: linear-gradient(135deg, #52b788, #1a4731);
    box-shadow: 0 6px 16px rgba(45,106,79,.24);
  }

  .ds-card-icon.pending { background: linear-gradient(135deg, #ffca28, #f57f17); box-shadow: 0 6px 16px rgba(245,127,23,.2); }
  .ds-card-icon.danger  { background: linear-gradient(135deg, #ef5350, #b03030); box-shadow: 0 6px 16px rgba(176,48,48,.2); }
  .ds-card-icon.closed  { background: #d8dcd9; box-shadow: none; }

  .ds-card-body {
    flex: 1;
    min-width: 0;
  }

  .ds-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .ds-card-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--green-deep);
    line-height: 1.3;
  }

  .ds-card-id {
    font-size: 11px;
    color: #b1cbbe;
    font-family: 'DM Mono', monospace;
    margin-top: 2px;
    letter-spacing: .02em;
  }

  .ds-badge-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ds-badge-status::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ds-badge-aktif {
    background: var(--green-ghost);
    color: var(--green-mid);
    border: 1px solid var(--green-pale);
  }
  .ds-badge-aktif::before { background: var(--green-bright); }

  .ds-badge-pending {
    background: #fff8e1;
    color: #b5651d;
    border: 1px solid #ffe4a8;
  }
  .ds-badge-pending::before { background: #f57f17; }

  .ds-badge-danger {
    background: #fdecea;
    color: #c62828;
    border: 1px solid #f9c8c4;
  }
  .ds-badge-danger::before { background: #c62828; }

  .ds-badge-closed {
    background: #f3f4f6;
    color: #6b7280;
    border: 1px solid #e5e7eb;
  }
  .ds-badge-closed::before { background: #9ca3af; }

  /* ── META ROW ── */
  .ds-card-meta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .ds-meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    color: #9abfad;
  }

  .ds-meta-item svg { color: var(--green-light); flex-shrink: 0; }

  .ds-meta-item strong {
    color: var(--green-deep);
    font-weight: 700;
  }

  /* ── ACTION ── */
  .ds-card-action {
    flex-shrink: 0;
  }

  .ds-card-action form { margin: 0; }

  .ds-btn-detail {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: 22px;
    background: var(--green-mid);
    color: white;
    font-family: 'DM Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background .15s, transform .15s;
    white-space: nowrap;
  }

  .ds-btn-detail:hover { background: var(--green-deep); color: #fff; transform: translateY(-1px); }

  .ds-btn-pending { background: #f57f17; }
  .ds-btn-pending:hover { background: #c96c11; }

  .ds-btn-retry { background: #c62828; }
  .ds-btn-retry:hover { background: #a41f1f; }

  .ds-text-muted {
    font-size: 12.5px;
    color: #b8b8b8;
    font-style: italic;
    white-space: nowrap;
  }

  /* ── LOKASI ROW ── */
  .ds-card-footer {
    padding: 11px 22px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: #b1cbbe;
    border-top: 1px solid var(--green-ghost);
    background: #fbfefc;
  }

  .ds-card-footer svg { color: #c8dfd4; }

  /* ── EMPTY ── */
  .ds-empty {
    background: white;
    border: 1px dashed #cbe6d7;
    border-radius: 16px;
    padding: 56px 20px;
    text-align: center;
  }

  .ds-empty-icon {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--green-ghost);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
  }

  .ds-empty-title {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--green-deep);
    margin-bottom: 4px;
  }

  .ds-empty-sub {
    font-size: 12.5px;
    color: #9abfad;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .ds-page { padding: 20px 16px 40px; }
    .ds-summary { grid-template-columns: 1fr; }
    .ds-card-inner { flex-wrap: wrap; }
    .ds-card-action { width: 100%; }
    .ds-btn-detail { width: 100%; justify-content: center; }
    .ds-header-title { font-size: 1.5rem; }
  }
</style>

<div class="ds-page">

  <!-- HEADER -->
  <div class="ds-header">
    <div class="ds-header-eyebrow">Corporate Dashboard</div>
    <div class="ds-header-title">Donasi Saya</div>
    <div class="ds-header-sub">Pantau perkembangan pohon dari program donasi yang Anda ikuti</div>
  </div>

  <!-- SUMMARY -->
  <%
    const totalPohonAll = donasiBerhasil.reduce((sum, d) => sum + (d.jumlah_pohon || 0), 0);
  %>
  <div class="ds-summary">

    <div class="ds-summary-card">
      <div class="ds-summary-icon tree">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="1.7">
          <polygon points="12,2 7,9 17,9" stroke-linejoin="round"></polygon>
          <polygon points="12,6 5.5,14 18.5,14" stroke-linejoin="round"></polygon>
          <polygon points="12,10 4,20 20,20" stroke-linejoin="round"></polygon>
          <line x1="12" y1="20" x2="12" y2="22" stroke-linecap="round"></line>
        </svg>
      </div>
      <div>
        <div class="ds-summary-label">Program Berhasil</div>
        <div class="ds-summary-value"><%= donasiBerhasil.length %></div>
      </div>
    </div>

    <div class="ds-summary-card">
      <div class="ds-summary-icon money">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2">
          <rect x="2" y="5" width="20" height="14" rx="2"/>
          <path d="M2 10h20" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="ds-summary-label">Total Pohon</div>
        <div class="ds-summary-value"><%= totalPohonAll.toLocaleString('id-ID') %></div>
      </div>
    </div>

    <div class="ds-summary-card">
      <div class="ds-summary-icon alert">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v4l3 3" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="ds-summary-label">Perlu Tindakan</div>
        <div class="ds-summary-value"><%= donasiPerluTindakan.length %></div>
      </div>
    </div>

  </div>

  <!-- ============================== -->
  <!-- SECTION 1: Program Berhasil -->
  <!-- ============================== -->
  <div class="ds-section">

    <div class="ds-section-header">
      <h3>Program Berhasil Didonasikan</h3>
    </div>

    <% if (donasiBerhasil.length > 0) { %>
      <div class="ds-list">
        <% donasiBerhasil.forEach(item => { %>
          <div class="ds-card">
            <div class="ds-card-inner">

              <div class="ds-card-icon">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="1.7">
                  <polygon points="12,2 7,9 17,9" stroke-linejoin="round"></polygon>
                  <polygon points="12,6 5.5,14 18.5,14" stroke-linejoin="round"></polygon>
                  <polygon points="12,10 4,20 20,20" stroke-linejoin="round"></polygon>
                  <line x1="12" y1="20" x2="12" y2="22" stroke-linecap="round"></line>
                </svg>
              </div>

              <div class="ds-card-body">
                <div class="ds-card-top">
                  <div>
                    <div class="ds-card-title"><%= item.program?.judul_program || '—' %></div>
                    <div class="ds-card-id">#<%= item.id_donasi %></div>
                  </div>
                  <span class="ds-badge-status ds-badge-aktif">Berhasil</span>
                </div>

                <div class="ds-card-meta">
                  <div class="ds-meta-item">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M12 22V12" stroke-linecap="round"/>
                      <path d="M12 12C12 12 8 9 8 5C8 2.5 10 1 12 1C14 1 16 2.5 16 5C16 9 12 12 12 12Z"/>
                    </svg>
                    <strong><%= (item.jumlah_pohon || 0).toLocaleString('id-ID') %></strong>&nbsp;pohon
                  </div>
                  <div class="ds-meta-item">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="5" width="20" height="14" rx="2"/>
                      <path d="M2 10h20" stroke-linecap="round"/>
                    </svg>
                    Rp&nbsp;<strong><%= Number(item.nominal_donasi || 0).toLocaleString('id-ID') %></strong>
                  </div>
                  <div class="ds-meta-item">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2"/>
                      <path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                    <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' }) : '—' %>
                  </div>
                </div>
              </div>

              <div class="ds-card-action">
                <a href="/corporate/dashboard-program/<%= item.id_donasi %>"
                   class="ds-btn-detail">
                  Lihat Dashboard
                  <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>

            </div>

            <% if (item.program?.provinsi || item.program?.kota) { %>
              <div class="ds-card-footer">
                <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <%= [item.program?.kota, item.program?.provinsi].filter(Boolean).join(', ') %>
              </div>
            <% } %>

          </div>
        <% }) %>
      </div>

    <% } else { %>
      <div class="ds-empty">
        <div class="ds-empty-icon">
          <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="#40916c" stroke-width="1.5">
            <path d="M12 22V12" stroke-linecap="round"/>
            <path d="M12 12C12 12 8 9 8 5C8 2.5 10 1 12 1C14 1 16 2.5 16 5C16 9 12 12 12 12Z"/>
          </svg>
        </div>
        <div class="ds-empty-title">Belum ada donasi berhasil</div>
        <div class="ds-empty-sub">Donasi yang sudah lunas akan muncul di sini</div>
      </div>
    <% } %>

  </div>

  <!-- ============================== -->
  <!-- SECTION 2: Perlu Tindakan -->
  <!-- ============================== -->
  <% if (donasiPerluTindakan.length > 0) { %>
  <div class="ds-section">

    <div class="ds-section-header">
      <h3>Perlu Tindakan</h3>
      <span class="ds-section-sub">Selesaikan pembayaran agar donasi diproses</span>
    </div>

    <div class="ds-list">
      <% donasiPerluTindakan.forEach(item => { %>

        <%
          let statusLabel = 'Menunggu Pembayaran';
          let badgeCls = 'ds-badge-pending';
          let iconCls = 'pending';
          let kind = 'pending';

          if (item.statusDonasi === 'program_berakhir') {
            statusLabel = 'Program Berakhir';
            badgeCls = 'ds-badge-closed';
            iconCls = 'closed';
            kind = 'closed';
          } else if (item.statusDonasi === 'expired') {
            statusLabel = 'Kadaluarsa';
            badgeCls = 'ds-badge-danger';
            iconCls = 'danger';
            kind = 'danger';
          } else if (item.statusDonasi === 'failed') {
            statusLabel = 'Gagal';
            badgeCls = 'ds-badge-danger';
            iconCls = 'danger';
            kind = 'danger';
          } else if (item.statusDonasi === 'cancelled') {
            statusLabel = 'Dibatalkan';
            badgeCls = 'ds-badge-danger';
            iconCls = 'danger';
            kind = 'danger';
          }
        %>

        <div class="ds-card">
          <div class="ds-card-inner">

            <div class="ds-card-icon <%= iconCls %>">
              <% if (kind === 'closed') { %>
                <svg width="19" height="19" fill="none" viewBox="0 0 24 24" stroke="#757575" stroke-width="2">
                  <rect x="4" y="10" width="16" height="10" rx="1.5"/>
                  <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke-linecap="round"/>
                </svg>
              <% } else if (kind === 'danger') { %>
                <svg width="19" height="19" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                </svg>
              <% } else { %>
                <svg width="19" height="19" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 8v4l3 3" stroke-linecap="round"/>
                </svg>
              <% } %>
            </div>

            <div class="ds-card-body">
              <div class="ds-card-top">
                <div>
                  <div class="ds-card-title"><%= item.program?.judul_program || '—' %></div>
                  <div class="ds-card-id">#<%= item.id_donasi %></div>
                </div>
                <span class="ds-badge-status <%= badgeCls %>"><%= statusLabel %></span>
              </div>

              <div class="ds-card-meta">
                <div class="ds-meta-item">
                  <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 22V12" stroke-linecap="round"/>
                    <path d="M12 12C12 12 8 9 8 5C8 2.5 10 1 12 1C14 1 16 2.5 16 5C16 9 12 12 12 12Z"/>
                  </svg>
                  <strong><%= (item.jumlah_pohon || 0).toLocaleString('id-ID') %></strong>&nbsp;pohon
                </div>
                <div class="ds-meta-item">
                  <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <path d="M2 10h20" stroke-linecap="round"/>
                  </svg>
                  Rp&nbsp;<strong><%= Number(item.nominal_donasi || 0).toLocaleString('id-ID') %></strong>
                </div>
              </div>
            </div>

            <div class="ds-card-action">

              <% if (item.statusDonasi === 'program_berakhir') { %>

                <span class="ds-text-muted">Tidak dapat diproses</span>

              <% } else if (item.statusDonasi === 'pending' && item.sudahPilihMetode) { %>

                <span class="ds-text-muted">Menunggu pembayaran masuk</span>

              <% } else if (item.statusDonasi === 'pending') { %>

                <a href="/payment/<%= item.activeOrderId %>" class="ds-btn-detail ds-btn-pending">
                  Lanjutkan Pembayaran
                </a>

              <% } else { %>

                <form action="/donasi/<%= item.id_donasi %>/retry-payment" method="POST">
                  <button type="submit" class="ds-btn-detail ds-btn-retry">
                    Bayar Ulang
                  </button>
                </form>

              <% } %>

            </div>

          </div>
        </div>
      <% }) %>
    </div>

  </div>
  <% } %>

</div>