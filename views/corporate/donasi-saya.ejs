<% layout('layouts/corporate') %>

<style>
  :root {
    --green-deep:   #1a4731;
    --green-mid:    #2d6a4f;
    --green-bright: #40916c;
    --green-light:  #74c69d;
    --green-pale:   #d8f3dc;
    --green-ghost:  #f0faf4;
    --brown-mid:    #7d5a3c;
    --brown-light:  #c9a87c;
    --cream:        #fdf8f0;
  }

  .ds-page {
    padding: 28px 32px 48px;
    background: var(--cream);
    min-height: 100vh;
    font-family: 'DM Sans', sans-serif;
    max-width: 960px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* ── HEADER ── */
  .ds-header {
    margin-bottom: 24px;
  }

  .ds-header-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--green-bright);
    margin-bottom: 6px;
  }

  .ds-header-title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.8rem;
    color: var(--green-deep);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .ds-header-sub {
    font-size: 13px;
    color: #9abfad;
    font-weight: 400;
  }

  /* ── SUMMARY ROW ── */
  .ds-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .ds-summary-card {
    background: white;
    border: 1px solid #dceee3;
    border-radius: 12px;
    padding: 16px 18px;
  }

  .ds-summary-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: #9abfad;
    margin-bottom: 6px;
  }

  .ds-summary-value {
    font-family: 'DM Serif Display', serif;
    font-size: 1.8rem;
    color: var(--green-deep);
    line-height: 1;
  }

  /* ── LIST ── */
  .ds-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ds-card {
    background: white;
    border: 1px solid #dceee3;
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow .2s, transform .2s;
  }

  .ds-card:hover {
    box-shadow: 0 6px 24px rgba(26,71,49,.08);
    transform: translateY(-1px);
  }

  .ds-card-inner {
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* Accent strip kiri */
  .ds-card-strip {
    width: 4px;
    align-self: stretch;
    background: linear-gradient(to bottom, var(--green-bright), var(--green-mid));
    flex-shrink: 0;
  }

  .ds-card-body {
    flex: 1;
    padding: 18px 20px;
    min-width: 0;
  }

  .ds-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .ds-card-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--green-deep);
    line-height: 1.3;
  }

  .ds-card-id {
    font-size: 11px;
    color: #9abfad;
    font-family: 'DM Mono', monospace;
    margin-top: 2px;
  }

  .ds-badge-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 11px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ds-badge-status::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ds-badge-aktif {
    background: var(--green-ghost);
    color: var(--green-mid);
    border: 1px solid var(--green-pale);
  }

  .ds-badge-aktif::before { background: var(--green-bright); }

  .ds-badge-selesai {
    background: #f3f4f6;
    color: #6b7280;
    border: 1px solid #e5e7eb;
  }

  .ds-badge-selesai::before { background: #9ca3af; }

  /* ── META ROW ── */
  .ds-card-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ds-meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #9abfad;
  }

  .ds-meta-item svg { color: var(--green-light); flex-shrink: 0; }

  .ds-meta-item strong {
    color: var(--green-deep);
    font-weight: 600;
  }

  /* ── ACTION ── */
  .ds-card-action {
    padding: 0 20px 0 0;
    flex-shrink: 0;
  }

  .ds-btn-detail {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 20px;
    background: var(--green-mid);
    color: white;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background .15s;
    white-space: nowrap;
  }

  .ds-btn-detail:hover { background: var(--green-deep); }

  /* ── DIVIDER ── */
  .ds-card-divider {
    height: 1px;
    background: var(--green-ghost);
    margin: 0 20px;
  }

  /* ── LOKASI ROW ── */
  .ds-card-footer {
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #b8d4c4;
  }

  .ds-card-footer svg { color: #c8dfd4; }

  /* ── EMPTY ── */
  .ds-empty {
    background: white;
    border: 1px solid #dceee3;
    border-radius: 14px;
    padding: 52px 20px;
    text-align: center;
    color: #b8d4c4;
  }

  .ds-empty svg {
    display: block;
    margin: 0 auto 12px;
    color: #c8dfd4;
  }

  .ds-empty-title {
    font-size: 14px;
    font-weight: 600;
    color: #9abfad;
    margin-bottom: 4px;
  }

  .ds-empty-sub {
    font-size: 12px;
    color: #b8d4c4;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .ds-page { padding: 16px 16px 40px; }
    .ds-summary { grid-template-columns: 1fr 1fr; }
    .ds-card-inner { flex-wrap: wrap; }
    .ds-card-action { padding: 0 20px 16px; width: 100%; }
    .ds-btn-detail { width: 100%; justify-content: center; }
    .ds-header-title { font-size: 1.4rem; }
  }

  @media (max-width: 380px) {
    .ds-summary { grid-template-columns: 1fr; }
  }
</style>

<div class="ds-page">

  <!-- HEADER -->
  <div class="ds-header">
    <div class="ds-header-eyebrow">Corporate Dashboard</div>
    <div class="ds-header-title">Donasi Saya</div>
    <div class="ds-header-sub">Pantau perkembangan pohon dari program donasi yang Anda ikuti</div>
  </div>

  <!-- SUMMARY -->
  <%
    const totalDonasi   = data.length;
    const totalPohonAll = data.reduce((sum, d) => sum + (d.jumlah_pohon || 0), 0);
    const totalAktif    = data.filter(d => d.program?.status === 'aktif').length;
  %>
  <div class="ds-summary">
    <div class="ds-summary-card">
      <div class="ds-summary-label">Total Program</div>
      <div class="ds-summary-value"><%= totalDonasi %></div>
    </div>
    <div class="ds-summary-card">
      <div class="ds-summary-label">Total Pohon</div>
      <div class="ds-summary-value"><%= totalPohonAll.toLocaleString('id-ID') %></div>
    </div>
    <div class="ds-summary-card">
      <div class="ds-summary-label">Program Aktif</div>
      <div class="ds-summary-value"><%= totalAktif %></div>
    </div>
  </div>

  <!-- LIST -->
  <% if (data.length > 0) { %>
    <div class="ds-list">
      <% data.forEach(item => { %>
        <div class="ds-card">
          <div class="ds-card-inner">

            <div class="ds-card-strip"></div>

            <div class="ds-card-body">
              <div class="ds-card-top">
                <div>
                  <div class="ds-card-title"><%= item.program?.judul_program || '—' %></div>
                  <div class="ds-card-id">#<%= item.id_donasi %></div>
                </div>
              </div>

              <div class="ds-card-meta">
                <div class="ds-meta-item">
                  <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 22V12" stroke-linecap="round"/>
                    <path d="M12 12C12 12 8 9 8 5C8 2.5 10 1 12 1C14 1 16 2.5 16 5C16 9 12 12 12 12Z"/>
                  </svg>
                  <strong><%= (item.jumlah_pohon || 0).toLocaleString('id-ID') %></strong>&nbsp;pohon
                </div>
                <div class="ds-meta-item">
                  <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <path d="M2 10h20" stroke-linecap="round"/>
                  </svg>
                  Rp&nbsp;<strong><%= Number(item.total_donasi || 0).toLocaleString('id-ID') %></strong>
                </div>
                <div class="ds-meta-item">
                  <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                  </svg>
                  <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' }) : '—' %>
                </div>
              </div>
            </div>

            <div class="ds-card-action">
              <a href="/corporate/dashboard-program/<%= item.id_donasi %>"
                 class="ds-btn-detail">
                Lihat Dashboard
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>

          </div>

          <% if (item.program?.provinsi || item.program?.kota) { %>
            <div class="ds-card-divider"></div>
            <div class="ds-card-footer">
              <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <%= [item.program?.kota, item.program?.provinsi].filter(Boolean).join(', ') %>
            </div>
          <% } %>

        </div>
      <% }) %>
    </div>

  <% } else { %>
    <div class="ds-empty">
      <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
        <path d="M12 22V12" stroke-linecap="round"/>
        <path d="M12 12C12 12 8 9 8 5C8 2.5 10 1 12 1C14 1 16 2.5 16 5C16 9 12 12 12 12Z"/>
        <path d="M9 22h6" stroke-linecap="round"/>
      </svg>
      <div class="ds-empty-title">Belum ada donasi</div>
      <div class="ds-empty-sub">Anda belum mengikuti program donasi apapun</div>
    </div>
  <% } %>

</div>
