<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - BabyTreeWarsi</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --green-deep:   #1a4731;
      --green-mid:    #2d6a4f;
      --green-bright: #40916c;
      --green-light:  #74c69d;
      --green-pale:   #d8f3dc;
      --green-ghost:  #f0faf4;
      --brown-mid:    #7d5a3c;
      --cream:        #fdf8f0;
    }

    body {
      min-height: 100vh;
      background: var(--green-ghost);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      font-family: 'Segoe UI', Arial, sans-serif;
    }

    /* ── Card ─────────────────────────────── */
    .card {
      background: #fff;
      border-radius: 20px;
      padding: 2.25rem 2rem;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 8px 32px rgba(26,71,49,.1);
      border: 1px solid var(--green-pale);
    }

    /* ── Logo / Brand ─────────────────────── */
    .brand {
      text-align: center;
      margin-bottom: 1.75rem;
    }

    .brand-icon {
      width: 56px;
      height: 56px;
      background: var(--green-pale);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto .75rem;
    }

    .brand-icon svg {
      color: var(--green-mid);
    }

    .brand h1 {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--green-deep);
      margin-bottom: .25rem;
    }

    .brand p {
      font-size: .85rem;
      color: #888;
      line-height: 1.5;
    }

    /* ── Alert ────────────────────────────── */
    .alert {
      display: flex;
      align-items: flex-start;
      gap: .6rem;
      padding: .8rem 1rem;
      border-radius: 10px;
      font-size: .85rem;
      font-weight: 500;
      margin-bottom: 1.25rem;
      line-height: 1.5;
    }

    .alert-success {
      background: var(--green-pale);
      color: var(--green-deep);
      border: 1px solid var(--green-light);
    }

    .alert-error {
      background: #fff0f0;
      color: #8b1a1a;
      border: 1px solid #f5a5a5;
    }

    .alert svg { flex-shrink: 0; width: 17px; height: 17px; margin-top: 1px; }

    /* ── Form ─────────────────────────────── */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: .4rem;
      margin-bottom: 1.25rem;
    }

    .form-group label {
      font-size: .8rem;
      font-weight: 600;
      color: var(--green-mid);
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .form-group input {
      padding: .7rem .95rem;
      border: 1.5px solid var(--green-pale);
      border-radius: 10px;
      font-size: .9rem;
      color: var(--green-deep);
      outline: none;
      transition: border-color .2s, box-shadow .2s;
      width: 100%;
    }

    .form-group input:focus {
      border-color: var(--green-bright);
      box-shadow: 0 0 0 3px rgba(64,145,108,.12);
    }

    .form-group input::placeholder { color: #bbb; }

    /* ── Tombol submit ────────────────────── */
    .btn-submit {
      width: 100%;
      padding: .85rem;
      background: var(--green-mid);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: .95rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      transition: background .2s, transform .1s;
      letter-spacing: .02em;
      margin-bottom: 1.25rem;
    }

    .btn-submit:hover  { background: var(--green-bright); }
    .btn-submit:active { transform: scale(.98); }

    /* ── Link kembali ─────────────────────── */
    .back-link {
      text-align: center;
      font-size: .85rem;
      color: #888;
    }

    .back-link a {
      color: var(--green-mid);
      font-weight: 600;
      text-decoration: none;
    }

    .back-link a:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <div class="card">

    <!-- Brand -->
    <div class="brand">
      <div class="brand-icon">
        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
        </svg>
      </div>
      <h1>Lupa Password?</h1>
      <p>Masukkan email akun Anda dan kami akan<br>mengirimkan link untuk reset password.</p>
    </div>

    <!-- Alert -->
    <% if (success) { %>
      <div class="alert alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
        <%= success %>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-error">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
        </svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/forgot-password" method="POST">
      <div class="form-group">
        <label>Alamat Email</label>
        <input
          type="email"
          name="email"
          placeholder="emailanda@gmail.com"
          required
          autofocus>
      </div>

      <button type="submit" class="btn-submit">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
        </svg>
        Kirim Link Reset
      </button>
    </form>

    <div class="back-link">
      Ingat password Anda? <a href="/login">Kembali ke Login</a>
    </div>

  </div>

</body>
</html>
