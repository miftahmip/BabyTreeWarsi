<% layout('layouts/petugas') %>

<style>
  /* ── Tokens ─────────────────────────────── */
  :root {
    --green-deep:   #1a4731;
    --green-mid:    #2d6a4f;
    --green-bright: #40916c;
    --green-light:  #74c69d;
    --green-pale:   #d8f3dc;
    --green-ghost:  #f0faf4;
    --brown-mid:    #7d5a3c;
    --cream:        #fdf8f0;
  }

  /* ── Layout ─────────────────────────────── */
  .scan-page {
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 1rem 2rem;
    background: transparent;
  }

  .scan-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .scan-header h1 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green-deep);
    margin: 0 0 .3rem;
  }

  .scan-header p {
    font-size: .875rem;
    color: var(--green-mid);
    margin: 0;
  }

  /* ── Viewfinder ──────────────────────────── */
  .viewfinder-wrap {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 8px 32px rgba(26,71,49,.25);
  }

  #video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Corner brackets */
  .corner {
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: var(--green-light);
    border-style: solid;
    border-width: 0;
    z-index: 2;
  }
  .corner.tl { top: 14px; left: 14px;  border-top-width: 3px;    border-left-width: 3px;   border-top-left-radius: 6px; }
  .corner.tr { top: 14px; right: 14px; border-top-width: 3px;    border-right-width: 3px;  border-top-right-radius: 6px; }
  .corner.bl { bottom: 14px; left: 14px;  border-bottom-width: 3px; border-left-width: 3px;   border-bottom-left-radius: 6px; }
  .corner.br { bottom: 14px; right: 14px; border-bottom-width: 3px; border-right-width: 3px;  border-bottom-right-radius: 6px; }

  /* Scanning laser line */
  .scan-laser {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--green-light), transparent);
    border-radius: 2px;
    z-index: 2;
    animation: laser 2s ease-in-out infinite;
  }

  @keyframes laser {
    0%   { top: 14px;   opacity: .8; }
    50%  { top: calc(100% - 14px); opacity: 1; }
    100% { top: 14px;   opacity: .8; }
  }

  /* Overlay saat kamera belum aktif */
  .cam-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(26,71,49,.85);
    gap: .75rem;
    z-index: 3;
    transition: opacity .3s;
  }

  .cam-placeholder.hidden { opacity: 0; pointer-events: none; }

  .cam-placeholder svg {
    width: 52px;
    height: 52px;
    color: var(--green-light);
  }

  .cam-placeholder span {
    font-size: .8rem;
    color: var(--green-pale);
    text-align: center;
    padding: 0 1.5rem;
    line-height: 1.5;
  }

  /* Canvas tersembunyi untuk proses frame */
  #canvas { display: none; }

  /* ── Status badge ────────────────────────── */
  .scan-status {
    margin-top: 1.25rem;
    width: 100%;
    max-width: 340px;
    min-height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .65rem 1rem;
    font-size: .85rem;
    font-weight: 500;
    transition: all .25s;
    background: var(--green-pale);
    color: var(--green-deep);
    border: 1.5px solid var(--green-light);
  }

  .scan-status.error {
    background: #fff0f0;
    color: #8b1a1a;
    border-color: #f5a5a5;
  }

  .scan-status.loading {
    background: #fff8e6;
    color: #7a5200;
    border-color: #f5d78a;
  }

  .scan-status svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  /* ── Tombol mulai scan ───────────────────── */
  .btn-scan-start {
    margin-top: 1.5rem;
    width: 100%;
    max-width: 340px;
    padding: .85rem;
    background: var(--green-mid);
    color: #fff;
    border: none;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    transition: background .2s, transform .1s;
    letter-spacing: .02em;
  }

  .btn-scan-start:hover  { background: var(--green-bright); }
  .btn-scan-start:active { transform: scale(.97); }
  .btn-scan-start:disabled {
    background: var(--green-light);
    cursor: default;
    transform: none;
  }

  /* ── Tombol stop ─────────────────────────── */
  .btn-scan-stop {
    margin-top: .75rem;
    width: 100%;
    max-width: 340px;
    padding: .7rem;
    background: transparent;
    color: var(--green-mid);
    border: 1.5px solid var(--green-mid);
    border-radius: 14px;
    font-size: .9rem;
    font-weight: 600;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    transition: all .2s;
  }

  .btn-scan-stop.visible { display: flex; }
  .btn-scan-stop:hover { background: var(--green-pale); }

  /* ── Tip ─────────────────────────────────── */
  .scan-tip {
    margin-top: 1.5rem;
    max-width: 340px;
    background: var(--cream);
    border-left: 3px solid var(--green-bright);
    border-radius: 0 10px 10px 0;
    padding: .75rem 1rem;
    font-size: .8rem;
    color: var(--brown-mid);
    line-height: 1.6;
  }

  .scan-tip strong {
    color: var(--green-deep);
  }
</style>

<div class="scan-page">

  <div class="scan-header">
    <h1>Scan QR Pohon</h1>
    <p>Arahkan kamera ke QR Code yang tertera pada label pohon</p>
  </div>

  <!-- Viewfinder -->
  <div class="viewfinder-wrap">
    <video id="video" playsinline autoplay muted></video>
    <canvas id="canvas"></canvas>
    <div class="corner tl"></div>
    <div class="corner tr"></div>
    <div class="corner bl"></div>
    <div class="corner br"></div>
    <div class="scan-laser" id="laser" style="display:none;"></div>

    <!-- Placeholder sebelum kamera aktif -->
    <div class="cam-placeholder" id="camPlaceholder">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
      </svg>
      <span>Tekan <strong>Mulai Scan</strong> untuk mengaktifkan kamera</span>
    </div>
  </div>

  <!-- Status -->
  <div class="scan-status" id="scanStatus">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round"
        d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
    </svg>
    <span id="statusText">Kamera belum aktif. Tekan tombol di bawah untuk mulai.</span>
  </div>

  <!-- Tombol Mulai -->
  <button class="btn-scan-start" id="btnStart" onclick="startScan()">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="20" height="20">
      <path stroke-linecap="round" stroke-linejoin="round"
        d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
      <path stroke-linecap="round" stroke-linejoin="round"
        d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z" />
    </svg>
    Mulai Scan
  </button>

  <!-- Tombol Stop -->
  <button class="btn-scan-stop" id="btnStop" onclick="stopScan()">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="18" height="18">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 7.5A2.25 2.25 0 0 1 7.5 5.25h9a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-9a2.25 2.25 0 0 1-2.25-2.25v-9Z" />
    </svg>
    Hentikan Kamera
  </button>

  <!-- Tip -->
  <div class="scan-tip">
    <strong>Tips:</strong> Pastikan QR Code terlihat jelas, tidak tertutup, dan area sekitar cukup terang.
    Tahan kamera sejajar dan stabil ±15–20 cm dari label pohon.
  </div>

</div>

<!-- jsQR library (decode QR dari frame video) -->
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>

<script>
  const video     = document.getElementById('video');
  const canvas    = document.getElementById('canvas');
  const ctx       = canvas.getContext('2d');
  const laser     = document.getElementById('laser');
  const btnStart  = document.getElementById('btnStart');
  const btnStop   = document.getElementById('btnStop');
  const statusEl  = document.getElementById('scanStatus');
  const statusTxt = document.getElementById('statusText');
  const placeholder = document.getElementById('camPlaceholder');

  let stream      = null;
  let rafId       = null;
  let scanning    = false;
  let processing  = false; // cegah double-hit saat QR terbaca

  // ── Ubah tampilan status ──────────────────
  function setStatus(type, text) {
    statusEl.className = 'scan-status' + (type ? ' ' + type : '');
    statusTxt.textContent = text;
  }

  // ── Mulai scan ────────────────────────────
  async function startScan() {
    try {
      setStatus('loading', 'Mengaktifkan kamera…');
      btnStart.disabled = true;

      stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
      });

      video.srcObject = stream;
      await video.play();

      placeholder.classList.add('hidden');
      laser.style.display = 'block';
      btnStop.classList.add('visible');
      btnStart.style.display = 'none';
      scanning = true;

      setStatus('', 'Kamera aktif — arahkan ke QR Code pohon');
      requestAnimationFrame(tick);

    } catch (err) {
      btnStart.disabled = false;
      if (err.name === 'NotAllowedError') {
        setStatus('error', 'Izin kamera ditolak. Aktifkan izin kamera di pengaturan browser.');
      } else if (err.name === 'NotFoundError') {
        setStatus('error', 'Kamera tidak ditemukan di perangkat ini.');
      } else {
        setStatus('error', 'Gagal mengaktifkan kamera: ' + err.message);
      }
    }
  }

  // ── Hentikan scan ─────────────────────────
  function stopScan() {
    scanning = false;
    processing = false;
    if (rafId) cancelAnimationFrame(rafId);
    if (stream) stream.getTracks().forEach(t => t.stop());

    video.srcObject = null;
    placeholder.classList.remove('hidden');
    laser.style.display = 'none';
    btnStop.classList.remove('visible');
    btnStart.style.display = 'flex';
    btnStart.disabled = false;

    setStatus('', 'Kamera dimatikan. Tekan tombol untuk scan lagi.');
  }

  // ── Loop baca frame ───────────────────────
  function tick() {
    if (!scanning) return;

    if (video.readyState === video.HAVE_ENOUGH_DATA) {
      canvas.width  = video.videoWidth;
      canvas.height = video.videoHeight;
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const code = jsQR(imageData.data, imageData.width, imageData.height, {
        inversionAttempts: 'dontInvert',
      });

      if (code && !processing) {
        processing = true;
        handleResult(code.data);
        return; // hentikan loop sementara
      }
    }

    rafId = requestAnimationFrame(tick);
  }

  // ── Kirim hasil scan ke backend ───────────
  async function handleResult(qrData) {
    setStatus('loading', 'QR terbaca — memverifikasi data pohon…');
    laser.style.animation = 'none'; // freeze laser

    try {
      const res = await fetch('/petugas-lapangan/pohon/scan', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ qr_result: qrData }),
      });

      const json = await res.json();

      if (json.success) {
        setStatus('', '✓ Pohon ditemukan! Mengarahkan ke halaman detail…');
        stopScan();
        setTimeout(() => {
          window.location.href = json.redirect_url;
        }, 700);
      } else {
        setStatus('error', json.message || 'QR tidak valid.');
        // reset agar bisa scan lagi
        setTimeout(() => {
          processing = false;
          laser.style.animation = '';
          setStatus('', 'Kamera aktif — arahkan ke QR Code pohon');
          rafId = requestAnimationFrame(tick);
        }, 2500);
      }

    } catch (err) {
      setStatus('error', 'Terjadi kesalahan jaringan. Coba lagi.');
      setTimeout(() => {
        processing = false;
        laser.style.animation = '';
        setStatus('', 'Kamera aktif — arahkan ke QR Code pohon');
        rafId = requestAnimationFrame(tick);
      }, 2500);
    }
  }

  // Bersihkan stream saat navigasi keluar
  window.addEventListener('beforeunload', () => {
    if (stream) stream.getTracks().forEach(t => t.stop());
  });
</script>
