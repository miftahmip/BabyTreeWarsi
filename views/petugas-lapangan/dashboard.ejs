<% layout('layouts/petugas') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --green-deep:   #1a4731;
    --green-mid:    #2d6a4f;
    --green-bright: #40916c;
    --green-light:  #74c69d;
    --green-pale:   #d8f3dc;
    --brown-mid:    #7d5a3c;
    --brown-dark:   #5c3d1e;
    --cream:        #fdf8f0;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  .dash-wrap {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    min-height: 100vh;
    padding: 1.5rem;
  }

  /* ── Header ── */
  .dash-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .dash-greeting {
    font-family: 'Lora', serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--green-deep);
    line-height: 1.2;
  }

  .dash-greeting span { color: var(--green-bright); }

  .dash-sub {
    font-size: 0.82rem;
    color: var(--brown-mid);
    margin-top: 0.25rem;
  }


  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

  /* ── Alert Banner ── */
  .alert-banner {
    background: #fffbf0;
    border: 1.5px solid #f0d98a;
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.75rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .alert-banner-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: #fdf4db;
    color: #b58000;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: 1rem;
  }

  .alert-banner-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #7a5000;
    margin-bottom: 0.3rem;
  }

  .alert-banner ul {
    padding-left: 1.1rem;
    margin: 0;
  }

  .alert-banner li {
    font-size: 0.8rem;
    color: #7a5000;
    margin-bottom: 0.1rem;
  }

  .alert-banner li strong { font-weight: 600; }

  /* ── Stat Cards ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .stat-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.25rem 1rem 1rem;
    position: relative;
    overflow: hidden;
    border: 1px solid #eaf0ec;
    transition: transform .2s, box-shadow .2s;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26,71,49,.09);
  }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: 16px 16px 0 0;
  }

  .stat-card.c-green::before  { background: var(--green-bright); }
  .stat-card.c-light::before  { background: var(--green-light); }
  .stat-card.c-brown::before  { background: var(--brown-mid); }
  .stat-card.c-warn::before   { background: #d4a017; }

  .stat-icon {
    width: 40px; height: 40px;
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
  }

  .stat-card.c-green .stat-icon { background: var(--green-pale); color: var(--green-deep); }
  .stat-card.c-light .stat-icon { background: #e8f8ef; color: var(--green-bright); }
  .stat-card.c-brown .stat-icon { background: #f5ede4; color: var(--brown-dark); }
  .stat-card.c-warn  .stat-icon { background: #fdf4db; color: #b58000; }

  .stat-val {
    font-family: 'Lora', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--green-deep);
    line-height: 1;
  }

  .stat-lbl {
    font-size: 0.75rem;
    color: #8a9e94;
    margin-top: 0.3rem;
    line-height: 1.3;
  }

  /* ── Section Card ── */
  .section-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid #e8f0eb;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .section-head {
    padding: 1rem 1.25rem 0.85rem;
    border-bottom: 1px solid #f0f5f1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .section-title {
    font-family: 'Lora', serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--green-deep);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-title svg { width: 16px; height: 16px; color: var(--green-bright); flex-shrink: 0; }

  .section-link {
    font-size: 0.75rem;
    color: var(--green-bright);
    text-decoration: none;
    font-weight: 500;
  }

  .section-link:hover { text-decoration: underline; }

  /* ── Table ── */
  .tugas-table-wrap { overflow-x: auto; }

  .tugas-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .tugas-table thead th {
    padding: 0.7rem 1.25rem;
    text-align: left;
    font-size: 0.72rem;
    font-weight: 600;
    color: #8a9e94;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #f9fbfa;
    border-bottom: 1px solid #f0f5f1;
    white-space: nowrap;
  }

  .tugas-table tbody tr {
    border-bottom: 1px solid #f5f8f6;
    transition: background .15s;
  }

  .tugas-table tbody tr:last-child { border-bottom: none; }
  .tugas-table tbody tr:hover { background: #f7fbf8; }

  .tugas-table td {
    padding: 0.8rem 1.25rem;
    color: var(--green-deep);
    vertical-align: middle;
  }

  .td-program {
    font-weight: 500;
    max-width: 220px;
  }

  .td-program-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .td-date { color: #7e9c8c; white-space: nowrap; }

  .badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .badge-aktif   { background: var(--green-pale); color: var(--green-deep); }
  .badge-selesai { background: #e8f0fb; color: #2563eb; }
  .badge-lain    { background: #f5ede4; color: var(--brown-dark); }

  /* ── Empty State ── */
  .empty-state {
    padding: 2.5rem 1.25rem;
    text-align: center;
    color: #b0c2b8;
    font-size: 0.82rem;
  }

  .empty-state svg {
    width: 36px; height: 36px;
    margin: 0 auto 0.5rem;
    display: block;
    opacity: .35;
  }

  /* ── Bottom Grid (ringkasan + alert cards) ── */
  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .bottom-grid { grid-template-columns: 1fr 1fr; }
  }

  .summary-panel { padding: 0.25rem 0; }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.72rem 1.25rem;
    border-bottom: 1px solid #f0f5f1;
    font-size: 0.82rem;
  }

  .summary-row:last-child { border-bottom: none; }

  .summary-lbl { color: #7e9c8c; }

  .summary-val {
    font-weight: 500;
    color: var(--green-deep);
    font-family: 'Lora', serif;
  }

  /* ── Progress ── */
  .progress-section { padding: 0 1.25rem 1.25rem; }

  .progress-lbl {
    font-size: 0.74rem;
    color: var(--green-mid);
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.35rem;
    margin-top: 0.9rem;
  }

  .progress-track {
    height: 7px;
    background: var(--green-pale);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    border-radius: 999px;
    background: var(--green-bright);
    transition: width .7s ease;
  }

  .progress-fill.f-warn { background: #d4a017; }

  /* ── Alert Mini Cards ── */
  .alert-cards { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.25rem; }

  .alert-mini {
    border-radius: 12px;
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .alert-mini.a-danger { background: #fff6f6; border: 1.5px solid #f5c6c6; }
  .alert-mini.a-warn   { background: #fffbf0; border: 1.5px solid #f0d98a; }
  .alert-mini.a-ok     { background: #f4fbf6; border: 1.5px solid #b7e4c7; }

  .alert-mini-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: 1.1rem;
  }

  .a-danger .alert-mini-icon { background: #fdeaea; color: #c0392b; }
  .a-warn   .alert-mini-icon { background: #fdf4db; color: #b58000; }
  .a-ok     .alert-mini-icon { background: var(--green-pale); color: var(--green-deep); }

  .alert-mini-body { flex: 1; min-width: 0; }

  .alert-mini-count {
    font-family: 'Lora', serif;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1;
  }

  .a-danger .alert-mini-count { color: #c0392b; }
  .a-warn   .alert-mini-count { color: #a07000; }
  .a-ok     .alert-mini-count { color: var(--green-deep); }

  .alert-mini-desc { font-size: 0.74rem; color: #8a9e94; margin-top: 0.15rem; }

  .alert-mini-btn {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.28rem 0.65rem;
    border-radius: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .a-danger .alert-mini-btn { background: #fdeaea; color: #c0392b; }
  .a-warn   .alert-mini-btn { background: #fdf4db; color: #a07000; }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .dash-wrap { padding: 1rem; }
    .dash-greeting { font-size: 1.35rem; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .stat-val { font-size: 1.6rem; }
  }

  .val-danger { color: #c0392b; }
  .val-warn   { color: #a07000; }

  .fill-ok   { width: var(--fill-ok); background: var(--green-bright); }
  .fill-warn { background: #d4a017; }
</style>

<div class="dash-wrap">

  <!-- ═══ HEADER ═══ -->
  <div class="dash-header">
    <div>
      <div class="dash-greeting">
        Selamat datang, <span><%= user.nama_lengkap %></span> 👋
      </div>
      <div class="dash-sub">
        <%= new Date().toLocaleDateString('id-ID', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %>
      </div>
    </div>
  </div>



  <!-- ═══ STAT CARDS ═══ -->
  <div class="stats-grid">

    <div class="stat-card c-green">
      <div class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="20" height="20">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
      </div>
      <div class="stat-val"><%= penugasanAktif %></div>
      <div class="stat-lbl">Penugasan Aktif</div>
    </div>

    <div class="stat-card c-light">
      <div class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="20" height="20">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2 L6 10 H9 L4 17 H10 V22 H14 V17 H20 L15 10 H18 Z"/>
        </svg>
      </div>
      <div class="stat-val"><%= totalPohon %></div>
      <div class="stat-lbl">Total Pohon Ditanam</div>
    </div>

    <div class="stat-card c-brown">
      <div class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="20" height="20">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/>
        </svg>
      </div>
      <div class="stat-val"><%= totalMitra %></div>
      <div class="stat-lbl">Total Mitra</div>
    </div>

    <div class="stat-card c-warn">
      <div class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="20" height="20">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
      </div>
      <div class="stat-val"><%= monitoringMenunggu %></div>
      <div class="stat-lbl">Monitoring Menunggu</div>
    </div>

  </div>


  <!-- ═══ TABEL PENUGASAN TERBARU ═══ -->
  <div class="section-card">
    <div class="section-head">
      <div class="section-title">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
        </svg>
        Penugasan Terbaru
      </div>
      <a href="/petugas-lapangan/penanaman" class="section-link">Lihat semua →</a>
    </div>

    <% if (penugasanTerbaru && penugasanTerbaru.length > 0) { %>
    <div class="tugas-table-wrap">
      <table class="tugas-table">
        <thead>
          <tr>
            <th>Program</th>
            <th>Tanggal Mulai</th>
            <th>Tanggal Selesai</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% penugasanTerbaru.forEach(function(item) { %>
          <tr>
            <td class="td-program">
              <div class="td-program-name">
                <%= item.penanaman && item.penanaman.program ? item.penanaman.program.judul_program : '-' %>
              </div>
            </td>
            <td class="td-date">
              <%= item.penanaman && item.penanaman.tanggal_mulai
                ? new Date(item.penanaman.tanggal_mulai).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' })
                : '-' %>
            </td>
            <td class="td-date">
              <%= item.penanaman && item.penanaman.tanggal_selesai
                ? new Date(item.penanaman.tanggal_selesai).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' })
                : '-' %>
            </td>
            <td>
              <% const st = item.penanaman ? item.penanaman.status_penanaman : null; %>
              <% if (st === 'aktif') { %>
                <span class="badge badge-aktif">Aktif</span>
              <% } else if (st === 'selesai') { %>
                <span class="badge badge-selesai">Selesai</span>
              <% } else { %>
                <span class="badge badge-lain"><%= st || 'Lainnya' %></span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z"/>
      </svg>
      Belum ada penugasan
    </div>
    <% } %>
  </div>


  <!-- ═══ BOTTOM GRID: Ringkasan + Status Verifikasi ═══ -->
  <div class="bottom-grid">

    <!-- Ringkasan Angka -->
    <div class="section-card">
      <div class="section-head">
        <div class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/>
          </svg>
          Ringkasan
        </div>
      </div>

      <div class="summary-panel">
        <div class="summary-row">
          <span class="summary-lbl">Penugasan aktif</span>
          <span class="summary-val"><%= penugasanAktif %></span>
        </div>
        <div class="summary-row">
          <span class="summary-lbl">Total pohon</span>
          <span class="summary-val"><%= totalPohon %></span>
        </div>
        <div class="summary-row">
          <span class="summary-lbl">Mitra terdaftar</span>
          <span class="summary-val"><%= totalMitra %></span>
        </div>
        <div class="summary-row">
          <span class="summary-lbl">Pohon ditolak</span>
         <span class="summary-val <%= pohonDitolak > 0 ? 'val-danger' : '' %>"><%= pohonDitolak %></span>
        </div>
        <div class="summary-row">
          <span class="summary-lbl">Monitoring ditolak</span>
          <span class="summary-val <%= monitoringDitolak > 0 ? 'val-danger' : '' %>"><%= monitoringDitolak %></span>
        </div>
        <div class="summary-row">
          <span class="summary-lbl">Monitoring menunggu</span>
          <span class="summary-val <%= monitoringMenunggu > 0 ? 'val-warn' : '' %>"><%= monitoringMenunggu %></span>
        </div>
      </div>

      <% if (totalPohon > 0) { %>
      <div class="progress-section">
        <%
          const pctDitolak = Math.round((pohonDitolak / totalPohon) * 100);
          const pctOk = 100 - pctDitolak;
        %>
        <div class="progress-lbl">
          <span>Pohon terverifikasi</span>
          <span><%= pctOk %>%</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" style="--fill-ok: <%= pctOk %>%"></div>
        </div>

        <% if ((monitoringMenunggu + monitoringDitolak) > 0) { %>
        <%
          const totalMon = monitoringMenunggu + monitoringDitolak;
          const pctMon = Math.round((monitoringMenunggu / totalMon) * 100);
        %>
        <div class="progress-lbl">
          <span>Monitoring menunggu review</span>
          <span><%= pctMon %>%</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill f-warn" style="--fill-ok:<%= pctMon %>%"></div>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>

    <!-- Status Verifikasi -->
    <div class="section-card">
      <div class="section-head">
        <div class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
          </svg>
          Status Verifikasi
        </div>
      </div>

      <div class="alert-cards">

        <% if (daftarPohonRevisi.length > 0) { %>
        <% daftarPohonRevisi.forEach(item => { %>
            <div class="alert-mini a-danger">
            <div class="alert-mini-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="20" height="20">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
                </svg>
            </div>
            <div class="alert-mini-body">
                <div class="alert-mini-count">
                <%= item.dataValues.total_revisi %> pohon
                </div>
                <div class="alert-mini-desc">
                Penanaman <%= item.id_penanaman %>
                </div>
            </div>
            <a href="/petugas-lapangan/pohon/<%= item.id_penanaman %>?filter=revisi" class="alert-mini-btn">Tinjau</a>
            </div>
        <% }) %>
        <% } %>

        <% if (daftarMonitoringRevisi.length > 0) { %>
        <% daftarMonitoringRevisi.forEach(item => { %>
        <div class="alert-mini a-warn">
            <div class="alert-mini-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="20" height="20">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
                </svg>
            </div>
            <div class="alert-mini-body">
                <div class="alert-mini-count">
                <%= item.dataValues.total_revisi %> monitoring
                </div>
                <div class="alert-mini-desc">
                Penanaman <%= item.dataValues.id_penanaman %>
                </div>
            </div>
        </div>
        <a href="/petugas-lapangan/pohon/<%= item.dataValues.id_penanaman %>?filter=revisi" class="alert-mini-btn">Tinjau</a>
        </div>
        <% }) %>
        <% } %>


        <% if (daftarPohonRevisi.length === 0 && daftarMonitoringRevisi.length === 0) { %>
        <div class="alert-mini a-ok">
          <div class="alert-mini-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="20" height="20">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
          </div>
          <div class="alert-mini-body">
            <div class="alert-mini-desc">Tidak ada data yang perlu ditinjau</div>
          </div>
        </div>
        <% } %>

      </div>
    </div>

  </div>

</div>
