<% layout('layouts/pimpinan') %>
<% locals.activePage = 'dashboard' %>
<% locals.pageTitle  = 'Dashboard Pimpinan' %>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --green-deep:   #1a4731;
    --green-mid:    #2d6a4f;
    --green-bright: #40916c;
    --green-light:  #74c69d;
    --green-pale:   #d8f3dc;
    --green-ghost:  #f4faf6;
    --brown-mid:    #7d5a3c;
    --brown-dark:   #5c3d1e;
    --cream:        #fdf8f0;

    /* UI neutrals — mayoritas dipakai */
    --ink:          #111c15;
    --ink-mid:      #3a4d3f;
    --ink-soft:     #6b7f71;
    --border:       #e2ede6;
    --surface:      #ffffff;
    --bg:           #f7faf8;

    --radius:       12px;
    --shadow-xs:    0 1px 4px rgba(26,71,49,0.06);
    --shadow-sm:    0 2px 12px rgba(26,71,49,0.08);
    --shadow-md:    0 4px 24px rgba(26,71,49,0.11);

    /* Font untuk angka — tegas & monospaced feel */
    --font-num:     'Barlow Condensed', sans-serif;
    --font-body:    'Barlow', sans-serif;
    --font-display: 'Playfair Display', serif;
  }

  * { box-sizing: border-box; }

  body, .dash-wrap { font-family: var(--font-body); background: var(--bg); color: var(--ink); }

  /* ── Page Header ── */
  .page-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 28px; gap: 12px; flex-wrap: wrap;
  }
  .page-header-left h1 {
    font-family: var(--font-display);
    font-size: 1.65rem; font-weight: 700;
    color: var(--green-deep); margin: 0 0 3px;
  }
  .page-header-left p { font-size: .82rem; color: var(--ink-soft); margin: 0; }
  .page-header-meta {
    display: flex; align-items: center; gap: 8px;
    font-size: .75rem; color: var(--ink-soft);
    background: var(--surface); border: 1px solid var(--border);
    padding: 6px 14px; border-radius: 20px;
  }
  .page-header-meta svg { opacity: .6; }

  /* ── Divider label ── */
  .section-label {
    font-size: .68rem; font-weight: 700; letter-spacing: 1px;
    text-transform: uppercase; color: var(--ink-soft);
    display: flex; align-items: center; gap: 10px;
    margin: 24px 0 14px;
  }
  .section-label::after {
    content: ''; flex: 1; height: 1px; background: var(--border);
  }

  /* ── Summary Grid ── */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 4px;
  }
  @media (max-width: 1200px) { .summary-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px)  { .summary-grid { grid-template-columns: repeat(2, 1fr); } }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px 16px;
    box-shadow: var(--shadow-xs);
    position: relative;
    overflow: hidden;
    transition: box-shadow .2s, transform .18s;
  }
  .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }

  /* accent strip kiri */
  .stat-card::before {
    content: ''; position: absolute;
    left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--green-bright);
    border-radius: 0 2px 2px 0;
  }
  .stat-card.ac-deep::before   { background: var(--green-deep); }
  .stat-card.ac-mid::before    { background: var(--green-mid); }
  .stat-card.ac-brown::before  { background: var(--brown-mid); }
  .stat-card.ac-light::before  { background: var(--green-light); }

  .stat-label {
    font-size: .67rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .7px; color: var(--ink-soft); margin-bottom: 8px;
  }
  .stat-value {
    font-family: var(--font-num);
    font-size: 2.1rem; font-weight: 500;
    color: var(--ink); line-height: 1; margin-bottom: 5px;
    letter-spacing: -.5px;
  }
  .stat-value.sm { font-size: 1.5rem; font-weight: 500; letter-spacing: -.3px; }
  .stat-sub { font-size: .72rem; color: var(--ink-soft); }

  /* ── Card base ── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
    box-shadow: var(--shadow-xs);
  }
  .card-title {
    font-family: var(--font-display);
    font-size: .95rem; font-weight: 700;
    color: var(--ink); margin-bottom: 2px;
  }
  .card-sub { font-size: .72rem; color: var(--ink-soft); margin-bottom: 16px; }
  .card-header {
    display: flex; align-items: flex-start;
    justify-content: space-between; gap: 10px;
    margin-bottom: 4px;
  }

  /* ── Tahun Picker ── */
  .tahun-filter-wrap { position: relative; flex-shrink: 0; }
  .tahun-display-btn {
    display: flex; align-items: center; gap: 6px;
    padding: 5px 11px; border-radius: 8px; cursor: pointer;
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font-body);
    font-size: .78rem; font-weight: 600; color: var(--ink-mid);
    transition: border-color .18s, background .18s; user-select: none;
  }
  .tahun-display-btn:hover { border-color: var(--green-bright); background: var(--surface); }
  .tahun-filter-wrap.open .tahun-display-btn svg:last-child { transform: rotate(180deg); }
  .tahun-dropdown {
    position: absolute; top: calc(100% + 5px); right: 0;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; box-shadow: var(--shadow-md);
    padding: 5px; min-width: 90px; z-index: 30;
    opacity: 0; transform: translateY(-6px) scale(.97);
    pointer-events: none; transition: opacity .16s, transform .16s;
    max-height: 200px; overflow-y: auto;
  }
  .tahun-filter-wrap.open .tahun-dropdown { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }
  .tahun-option {
    padding: 6px 14px; border-radius: 7px; font-size: .78rem;
    font-weight: 500; color: var(--ink); cursor: pointer;
    transition: background .12s; text-align: center;
  }
  .tahun-option:hover  { background: var(--green-ghost); }
  .tahun-option.active { background: var(--green-pale); color: var(--green-deep); font-weight: 700; }

  /* ── Charts 2-col ── */
  .charts-row { display: grid; grid-template-columns: 1.7fr 1fr; gap: 14px; margin-bottom: 14px; }
  @media (max-width: 1050px) { .charts-row { grid-template-columns: 1fr; } }

  /* ── Bar Chart ── */
  .bar-chart-wrap {
    height: 180px; display: flex; align-items: flex-end;
    gap: 5px; padding-bottom: 26px; position: relative;
  }
  .bar-col {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; height: 100%; justify-content: flex-end; position: relative;
  }
  .bar-fill {
    width: 100%; border-radius: 4px 4px 0 0;
    background: var(--green-bright);
    transition: height .55s cubic-bezier(.34,1.56,.64,1);
    position: relative; cursor: pointer;
  }
  .bar-fill.zero { background: var(--border); }
  .bar-fill:not(.zero):hover { background: var(--green-mid); }
  .bar-fill .bar-tooltip {
    position: absolute; bottom: calc(100% + 6px); left: 50%;
    transform: translateX(-50%); background: var(--ink); color: #fff;
    font-size: .63rem; font-weight: 600; padding: 3px 7px; border-radius: 5px;
    white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .13s; z-index: 5;
  }
  .bar-fill:hover .bar-tooltip { opacity: 1; }
  .bar-label { font-size: .58rem; color: var(--ink-soft); position: absolute; bottom: -20px; text-align: center; width: 100%; font-family: var(--font-body); }

  /* wilayah bar */
  .bar-fill-w {
    width: 100%; border-radius: 4px 4px 0 0;
    background: var(--green-mid);
    transition: height .55s cubic-bezier(.34,1.56,.64,1);
    position: relative; cursor: pointer;
  }
  .bar-fill-w:hover { background: var(--green-deep); }
  .bar-fill-w .bar-tooltip {
    position: absolute; bottom: calc(100% + 6px); left: 50%;
    transform: translateX(-50%); background: var(--ink); color: #fff;
    font-size: .63rem; font-weight: 600; padding: 3px 7px; border-radius: 5px;
    white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .13s; z-index: 5;
  }
  .bar-fill-w:hover .bar-tooltip { opacity: 1; }

  /* ── Donut Chart ── */
  .donut-wrap { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .donut-svg-wrap { position: relative; width: 140px; height: 140px; flex-shrink: 0; }
  .donut-center-text { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .donut-center-text strong { font-family: var(--font-num); font-size: 1.05rem; font-weight: 700; color: var(--ink); display: block; letter-spacing: -.5px; }
  .donut-center-text span { font-size: .6rem; color: var(--ink-soft); text-align: center; line-height: 1.3; }
  .donut-legend { display: flex; flex-wrap: wrap; gap: 5px 12px; justify-content: center; width: 100%; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: .7rem; }
  .legend-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .legend-name { color: var(--ink-mid); }
  .legend-pct  { font-family: var(--font-num); font-weight: 700; color: var(--ink); font-size: .75rem; }

  /* ── Pie Chart untuk Status Program ── */
  .pie-wrap { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin-top: 6px; }
  .pie-svg-wrap { position: relative; width: 130px; height: 130px; flex-shrink: 0; }
  .pie-legend { flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 120px; }
  .pie-leg-item { display: flex; align-items: center; gap: 8px; }
  .pie-leg-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }
  .pie-leg-info { flex: 1; }
  .pie-leg-label { font-size: .7rem; color: var(--ink-soft); font-weight: 500; text-transform: capitalize; }
  .pie-leg-count { font-family: var(--font-num); font-size: 1.05rem; font-weight: 700; color: var(--ink); line-height: 1.1; letter-spacing: -.3px; }
  .pie-leg-pct { font-size: .68rem; color: var(--ink-soft); }

  /* ── Insight Strip ── */
  .insight-strip {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 12px; margin-bottom: 14px;
  }
  @media (max-width: 900px)  { .insight-strip { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px)  { .insight-strip { grid-template-columns: 1fr; } }

  .insight-card {
    border-radius: var(--radius); padding: 16px 18px;
    border: 1px solid var(--border); background: var(--surface);
    display: flex; align-items: flex-start; gap: 14px;
    transition: box-shadow .18s;
  }
  .insight-card:hover { box-shadow: var(--shadow-sm); }
  .ic-icon {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ic-icon.green { background: var(--green-pale); }
  .ic-icon.brown { background: #f5ece3; }
  .ic-icon.teal  { background: #e3f4ef; }
  .ic-eyebrow { font-size: .63rem; text-transform: uppercase; letter-spacing: .7px; font-weight: 600; color: var(--ink-soft); margin-bottom: 3px; }
  .ic-value   { font-family: var(--font-body); font-size: .92rem; font-weight: 500; color: var(--ink); line-height: 1.3; }
  .ic-sub     { font-size: .68rem; color: var(--ink-soft); margin-top: 2px; }

  /* ── 3-col bottom row ── */
  .bottom-row {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 14px; margin-bottom: 24px;
  }
  @media (max-width: 1050px) { .bottom-row { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px)  { .bottom-row { grid-template-columns: 1fr; } }

  /* ── Top Corporate ── */
  .corp-list { display: flex; flex-direction: column; gap: 9px; }
  .corp-item { display: flex; align-items: center; gap: 10px; }
  .corp-rank {
    width: 22px; height: 22px; border-radius: 6px;
    background: var(--bg); border: 1px solid var(--border);
    color: var(--ink-soft); font-family: var(--font-num); font-size: .75rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .corp-rank.gold   { background: #fff8e1; border-color: #f0d060; color: #7a5800; }
  .corp-rank.silver { background: #f2f4f5; border-color: #c8cdd0; color: #505a60; }
  .corp-rank.bronze { background: #fdf0e8; border-color: #d4a070; color: #6a3800; }
  .corp-info { flex: 1; min-width: 0; }
  .corp-name { font-size: .78rem; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .corp-bar-wrap { height: 3px; background: var(--border); border-radius: 2px; margin-top: 4px; }
  .corp-bar { height: 3px; background: var(--green-bright); border-radius: 2px; transition: width .6s ease; }
  .corp-pohon { font-family: var(--font-num); font-size: .82rem; font-weight: 700; color: var(--green-deep); flex-shrink: 0; }

  /* ── Top Program ── */
  .prog-list { display: flex; flex-direction: column; gap: 8px; }
  .prog-item {
    padding: 9px 12px; border-radius: 9px;
    background: var(--bg); border: 1px solid var(--border);
    transition: background .15s;
  }
  .prog-item:hover { background: var(--green-ghost); }
  .prog-title { font-size: .78rem; font-weight: 600; color: var(--ink); margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .prog-meta  { display: flex; gap: 10px; }
  .prog-stat  { font-size: .68rem; color: var(--ink-soft); display: flex; align-items: center; gap: 3px; }
  .prog-stat strong { font-family: var(--font-num); font-weight: 700; color: var(--ink-mid); font-size: .75rem; }

  /* ── Wilayah full-width ── */
  .wilayah-section { margin-bottom: 14px; }

  /* ── Filter Wilayah Popup ── */
  .fw-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.3);
    z-index: 100; opacity: 0; pointer-events: none; transition: opacity .2s;
  }
  .fw-overlay.open { opacity: 1; pointer-events: all; }
  .fw-popup {
    position: fixed; top: 50%; left: 50%;
    transform: translate(-50%, -48%) scale(.96);
    background: var(--surface); border-radius: 16px;
    box-shadow: 0 16px 48px rgba(26,71,49,0.16);
    padding: 26px 28px; width: min(460px, 92vw); z-index: 101;
    opacity: 0; pointer-events: none;
    transition: opacity .2s, transform .2s;
  }
  .fw-overlay.open .fw-popup {
    opacity: 1; pointer-events: all;
    transform: translate(-50%, -50%) scale(1);
  }
  .fw-popup-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
  }
  .fw-popup-title {
    font-family: var(--font-display); font-size: .98rem; font-weight: 700;
    color: var(--ink); display: flex; align-items: center; gap: 8px;
  }
  .fw-close {
    width: 28px; height: 28px; border-radius: 50%; border: none;
    background: var(--bg); color: var(--ink-soft); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; transition: background .15s;
  }
  .fw-close:hover { background: var(--green-pale); color: var(--green-deep); }
  .fw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  @media (max-width: 480px) { .fw-grid { grid-template-columns: 1fr; } }
  .fw-group { display: flex; flex-direction: column; gap: 4px; }
  .fw-group label {
    font-size: .65rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .5px; color: var(--ink-soft);
  }
  .fw-group select {
    padding: 8px 11px; border: 1px solid var(--border); border-radius: 9px;
    font-family: var(--font-body); font-size: .8rem; color: var(--ink);
    background: var(--bg); outline: none; appearance: none; cursor: pointer;
    transition: border-color .18s, background .18s;
  }
  .fw-group select:focus  { border-color: var(--green-bright); background: var(--surface); }
  .fw-group select:disabled { opacity: .4; cursor: not-allowed; }
  .fw-actions { display: flex; gap: 8px; justify-content: flex-end; }
  .fw-btn {
    padding: 8px 20px; border-radius: 9px; font-size: .8rem; font-weight: 600;
    font-family: var(--font-body); cursor: pointer; border: none; transition: background .18s;
  }
  .fw-btn-apply { background: var(--green-deep); color: #fff; }
  .fw-btn-apply:hover { background: var(--green-mid); }
  .fw-btn-reset {
    background: var(--bg); color: var(--ink-mid);
    border: 1px solid var(--border); text-decoration: none;
    display: inline-flex; align-items: center;
  }
  .fw-btn-reset:hover { background: var(--green-pale); }
  .fw-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--green-deep); color: #fff; font-size: .6rem; font-weight: 700;
  }
  .btn-fw-open {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 8px; cursor: pointer;
    border: 1px solid var(--border); background: var(--bg);
    font-family: var(--font-body); font-size: .78rem; font-weight: 600;
    color: var(--ink-mid); transition: border-color .18s, background .18s;
  }
  .btn-fw-open:hover        { border-color: var(--green-bright); background: var(--surface); }
  .btn-fw-open.has-filter   { background: var(--green-pale); border-color: var(--green-bright); color: var(--green-deep); }
  .wilayah-type-badge {
    display: inline-flex; align-items: center; padding: 2px 9px;
    border-radius: 20px; font-size: .65rem; font-weight: 600;
    background: var(--green-pale); color: var(--green-deep); margin-left: 6px;
  }

  /* ── Misc ── */
  .rp { font-feature-settings: "tnum"; font-family: var(--font-num); }
  .empty-state { text-align: center; padding: 28px 0; color: var(--ink-soft); font-size: .8rem; }
  .icon-tree { display: inline-block; vertical-align: middle; }
</style>

<!-- ═══ PAGE HEADER ═══ -->
<div class="page-header">
  <div class="page-header-left">
    <h1>Dashboard Pimpinan</h1>
    <p>Ringkasan eksekutif program donasi pohon nasional</p>
  </div>
  <div class="page-header-meta">
    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2" stroke-linecap="round"/>
    </svg>
    Update: <%= new Date().toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) %>
  </div>
</div>

<!-- ═══ SUMMARY CARDS ═══ -->
<div class="section-label">Ringkasan Nasional</div>
<div class="summary-grid">

  <div class="stat-card ac-deep">
    <div class="stat-label">Total Program</div>
    <div class="stat-value"><%= totalProgram.toLocaleString('id-ID') %></div>
    <div class="stat-sub"><%= totalProvinsiAktif %> provinsi aktif</div>
  </div>

  <div class="stat-card ac-mid">
    <div class="stat-label">Total Pohon</div>
    <div class="stat-value"><%= totalPohon.toLocaleString('id-ID') %></div>
    <div class="stat-sub">Pohon ditanam</div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Total Donatur</div>
    <div class="stat-value"><%= totalDonatur.toLocaleString('id-ID') %></div>
    <div class="stat-sub">Donatur individu & corporate</div>
  </div>

  <div class="stat-card ac-brown">
    <div class="stat-label">Donatur Corporate</div>
    <div class="stat-value"><%= totalCorporate.toLocaleString('id-ID') %></div>
    <div class="stat-sub">Perusahaan / instansi</div>
  </div>

  <div class="stat-card ac-light" style="grid-column: span 2;">
    <div class="stat-label">Total Dana Terkumpul</div>
    <%
      var _d = totalDanaNasional;
      var _ds;
      if      (_d >= 1e9) { var _m = _d/1e9; _ds = 'Rp ' + (Number.isInteger(_m) ? _m.toLocaleString('id-ID') : parseFloat(_m.toFixed(2)).toLocaleString('id-ID',{minimumFractionDigits:0,maximumFractionDigits:2})) + ' Miliar'; }
      else if (_d >= 1e6) { var _j = _d/1e6; _ds = 'Rp ' + (Number.isInteger(_j) ? _j.toLocaleString('id-ID') : parseFloat(_j.toFixed(2)).toLocaleString('id-ID',{minimumFractionDigits:0,maximumFractionDigits:2})) + ' Juta'; }
      else if (_d >= 1e3) { var _r = _d/1e3; _ds = 'Rp ' + (Number.isInteger(_r) ? _r.toLocaleString('id-ID') : parseFloat(_r.toFixed(2)).toLocaleString('id-ID',{minimumFractionDigits:0,maximumFractionDigits:2})) + ' Ribu'; }
      else { _ds = 'Rp ' + _d.toLocaleString('id-ID'); }
    %>
    <div class="stat-value sm rp"><%= _ds %></div>
  </div>

</div>

<!-- ═══ INSIGHT STRIP ═══ -->
<div class="section-label">Sorotan</div>
<div class="insight-strip">

  <% if (provinsiTeraktif) { %>
  <div class="insight-card">
    <div class="ic-icon green">
      <svg width="20" height="20" viewBox="0 0 64 64" fill="var(--green-bright)">
        <polygon points="32,4 44,22 38,22 50,40 41,40 54,58 10,58 23,40 14,40 26,22 20,22"/>
      </svg>
    </div>
    <div>
      <div class="ic-eyebrow">Provinsi Teraktif</div>
      <div class="ic-value"><%= provinsiTeraktif.wilayah || '-' %></div>
      <div class="ic-sub"><%= provinsiTeraktif.total.toLocaleString('id-ID') %> pohon ditanam</div>
    </div>
  </div>
  <% } %>

  <% if (corporateTerbesar) { %>
    <%
      var _cNama  = corporateTerbesar.user ? corporateTerbesar.user.nama_lengkap : '-';
      var _cPohon = Number(corporateTerbesar.dataValues ? corporateTerbesar.dataValues.total_pohon : 0);
    %>
  <div class="insight-card">
    <div class="ic-icon brown">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="var(--brown-mid)" stroke-width="1.8">
        <rect x="3" y="9" width="18" height="12" rx="1"/><path d="M8 9V6a4 4 0 0 1 8 0v3" stroke-linecap="round"/>
      </svg>
    </div>
    <div style="min-width:0;flex:1;">
      <div class="ic-eyebrow">Corporate Terbesar</div>
      <div class="ic-value" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= _cNama %></div>
      <div class="ic-sub"><%= _cPohon.toLocaleString('id-ID') %> pohon</div>
    </div>
  </div>
  <% } %>

  <% if (programTerbaik) { %>
    <%
      var _pNama  = programTerbaik.program ? programTerbaik.program.judul_program : '-';
      var _pPohon = Number(programTerbaik.dataValues ? programTerbaik.dataValues.total_pohon : 0);
    %>
  <div class="insight-card">
    <div class="ic-icon teal">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="var(--green-mid)" stroke-width="1.8">
        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" stroke-linecap="round" stroke-linejoin="round"/>
        <polyline points="16 7 22 7 22 13" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div style="min-width:0;flex:1;">
      <div class="ic-eyebrow">Program Terbaik</div>
      <div class="ic-value" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= _pNama %></div>
      <div class="ic-sub"><%= _pPohon.toLocaleString('id-ID') %> pohon terkumpul</div>
    </div>
  </div>
  <% } %>

</div>

<!-- ═══ CHARTS ROW ═══ -->
<div class="section-label">Analitik</div>
<div class="charts-row">

  <!-- Donasi Bulanan -->
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Donasi Bulanan</div>
        <div class="card-sub" style="margin-bottom:0;">Total dana per bulan (settlement)</div>
      </div>
      <div class="tahun-filter-wrap" id="tahunWrap">
        <div class="tahun-display-btn" onclick="toggleTahunDropdown()">
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
          </svg>
          <span id="tahunLabel"><%= tahun %></span>
          <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="transition:transform .2s;">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="tahun-dropdown" id="tahunDropdown"></div>
      </div>
      <form id="tahunForm" method="GET" action="/pimpinan/dashboard" style="display:none;">
        <input type="hidden" name="tahun" id="tahunInput" value="<%= tahun %>">
      </form>
    </div>
    <div style="margin-top:16px;">
      <%
        var _maxDon = Math.max.apply(null, donasiBulanan.map(function(d){ return d.total; }).concat([1]));
      %>
      <div class="bar-chart-wrap" id="barChartDonasi">
        <% donasiBulanan.forEach(function(item) { %>
          <%
            var _pct = Math.round((item.total / _maxDon) * 100);
            var _h   = item.total > 0 ? Math.max(_pct, 4) : 3;
          %>
          <div class="bar-col">
            <div class="bar-fill <%= item.total === 0 ? 'zero' : '' %>" style="height:<%= _h + '%' %>;">
              <% if (item.total > 0) { %><span class="bar-tooltip" data-value="<%= item.total %>"></span><% } %>
            </div>
            <span class="bar-label"><%= item.bulan %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Sebaran Jenis Pohon Donut -->
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Jenis Pohon</div>
        <div class="card-sub" style="margin-bottom:0;">Komposisi pohon yang ditanam</div>
      </div>
    </div>
    <div style="margin-top:16px;">
      <%
        var _donutColors = ['#40916c','#2d6a4f','#74c69d','#1a4731','#52b788','#b7e4c7','#8ecaac'];
        var _donutTotal  = jenisPohonChart.reduce(function(s,j){ return s + Number(j.dataValues ? j.dataValues.total : j.total || 0); }, 0) || 1;
      %>
      <div class="donut-wrap">
        <div class="donut-svg-wrap">
          <svg viewBox="0 0 36 36" width="140" height="140">
            <%
              var _off = 25;
              jenisPohonChart.slice(0,7).forEach(function(item, idx) {
                var _v   = Number(item.dataValues ? item.dataValues.total : item.total || 0);
                var _p   = (_v / _donutTotal) * 100;
                var _da  = _p + ' ' + (100 - _p);
                var _col = _donutColors[idx % _donutColors.length];
            %>
              <circle cx="18" cy="18" r="15.91549" fill="transparent"
                stroke="<%= _col %>" stroke-width="4.5"
                stroke-dasharray="<%= _da %>"
                stroke-dashoffset="<%= _off %>"/>
            <%
                _off = _off - _p;
                if (_off < 0) _off += 100;
              });
            %>
            <circle cx="18" cy="18" r="12.5" fill="var(--surface)"/>
          </svg>
          <div class="donut-center-text">
            <strong><%= _donutTotal.toLocaleString('id-ID') %></strong>
            <span>Total<br/>Pohon</span>
          </div>
        </div>
        <div class="donut-legend">
          <% jenisPohonChart.slice(0,7).forEach(function(item, idx) { %>
            <%
              var _v2  = Number(item.dataValues ? item.dataValues.total : item.total || 0);
              var _p2  = ((_v2 / _donutTotal) * 100).toFixed(1);
              var _dc  = _donutColors[idx % _donutColors.length];
            %>
            <div class="legend-item" title="<%= item.nama_pohon %> — <%= _p2 %>%">
              <div class="legend-dot" style="background:<%= _dc %>;"></div>
              <span class="legend-name"><%= item.nama_pohon %></span>
              <span class="legend-pct"><%= _p2 %>%</span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- ═══ SEBARAN POHON PER WILAYAH ═══ -->
<%
  var _selProv = typeof kode_provinsi  !== 'undefined' ? kode_provinsi  : '';
  var _selKota = typeof kode_kbp_kota  !== 'undefined' ? kode_kbp_kota  : '';
  var _selKec  = typeof kode_kecamatan !== 'undefined' ? kode_kecamatan : '';
  var _selKel  = typeof kode_kelurahan !== 'undefined' ? kode_kelurahan : '';
  var _wTitle  = typeof wilayahTitle   !== 'undefined' ? wilayahTitle   : 'Provinsi';
  var _fCount  = [_selProv, _selKota, _selKec, _selKel].filter(Boolean).length;
  var _provinces = typeof provinces !== 'undefined' ? provinces : [];
  var _regencies = typeof regencies !== 'undefined' ? regencies : [];
  var _districts = typeof districts !== 'undefined' ? districts : [];
  var _villages  = typeof villages  !== 'undefined' ? villages  : [];
%>

<!-- Filter Overlay -->
<div class="fw-overlay" id="fwOverlay" onclick="handleFwOverlay(event)">
  <div class="fw-popup" id="fwPopup">
    <div class="fw-popup-header">
      <div class="fw-popup-title">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M7 12h10M11 18h2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Filter Wilayah
      </div>
      <button class="fw-close" onclick="closeFwPopup()">✕</button>
    </div>
    <form method="GET" action="/pimpinan/dashboard" id="fwForm">
      <input type="hidden" name="tahun" value="<%= tahun %>">
      <div class="fw-grid">
        <div class="fw-group">
          <label>Provinsi</label>
          <select name="kode_provinsi" id="fwProvinsi">
            <option value="">Semua Provinsi</option>
            <% _provinces.forEach(function(p) { %>
              <option value="<%= p.code %>" <%= _selProv == p.code ? 'selected' : '' %>><%= p.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="fw-group">
          <label>Kabupaten / Kota</label>
          <select name="kode_kbp_kota" id="fwKota" data-ph="Semua Kab/Kota" <%= !_selProv ? 'disabled' : '' %>>
            <option value="">Semua Kab/Kota</option>
            <% _regencies.forEach(function(r) { %>
              <option value="<%= r.code %>" <%= _selKota == r.code ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="fw-group">
          <label>Kecamatan</label>
          <select name="kode_kecamatan" id="fwKecamatan" data-ph="Semua Kecamatan" <%= !_selKota ? 'disabled' : '' %>>
            <option value="">Semua Kecamatan</option>
            <% _districts.forEach(function(d) { %>
              <option value="<%= d.code %>" <%= _selKec == d.code ? 'selected' : '' %>><%= d.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="fw-group">
          <label>Kelurahan</label>
          <select name="kode_kelurahan" id="fwKelurahan" data-ph="Semua Kelurahan" <%= !_selKec ? 'disabled' : '' %>>
            <option value="">Semua Kelurahan</option>
            <% _villages.forEach(function(v) { %>
              <option value="<%= v.code %>" <%= _selKel == v.code ? 'selected' : '' %>><%= v.name %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="fw-actions">
        <a href="/pimpinan/dashboard?tahun=<%= tahun %>" class="fw-btn fw-btn-reset">Reset</a>
        <button type="submit" class="fw-btn fw-btn-apply">Terapkan</button>
      </div>
    </form>
  </div>
</div>

<div class="card wilayah-section">
  <div class="card-header" style="margin-bottom:12px; align-items:center;">
    <div>
      <div class="card-title">
        Sebaran Pohon per Wilayah
        <span class="wilayah-type-badge">per <%= _wTitle %></span>
      </div>
      <div class="card-sub" style="margin-bottom:0;">
        <% if (_selProv) { %>
          Filter aktif:
          <strong style="color:var(--green-deep);">
            <%= _provinces.find(function(p){ return String(p.code) === String(_selProv); }) ? _provinces.find(function(p){ return String(p.code) === String(_selProv); }).name : _selProv %>
          </strong>
          <% if (_selKota) { %>
            &rsaquo; <strong style="color:var(--green-deep);"><%= _regencies.find(function(r){ return String(r.code) === String(_selKota); }) ? _regencies.find(function(r){ return String(r.code) === String(_selKota); }).name : _selKota %></strong>
          <% } %>
          <% if (_selKec) { %>
            &rsaquo; <strong style="color:var(--green-deep);"><%= _districts.find(function(d){ return String(d.code) === String(_selKec); }) ? _districts.find(function(d){ return String(d.code) === String(_selKec); }).name : _selKec %></strong>
          <% } %>
          <% if (_selKel) { %>
            &rsaquo; <strong style="color:var(--green-deep);"><%= _villages.find(function(v){ return String(v.code) === String(_selKel); }) ? _villages.find(function(v){ return String(v.code) === String(_selKel); }).name : _selKel %></strong>
          <% } %>
        <% } else { %>
          Klik Filter untuk mempersempit wilayah
        <% } %>
      </div>
    </div>
    <button class="btn-fw-open <%= _fCount > 0 ? 'has-filter' : '' %>" onclick="openFwPopup()">
      <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M7 12h10M11 18h2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Filter
      <% if (_fCount > 0) { %><span class="fw-badge"><%= _fCount %></span><% } %>
    </button>
  </div>

  <% if (!pohonPerWilayah || pohonPerWilayah.length === 0) { %>
    <div class="empty-state">Belum ada data sebaran wilayah.</div>
  <% } else { %>
    <%
      var _maxW = Math.max.apply(null, pohonPerWilayah.map(function(w){ return w.total; }).concat([1]));
      var _topW = pohonPerWilayah.slice().sort(function(a,b){ return b.total - a.total; }).slice(0,12);
    %>
    <div class="bar-chart-wrap" id="barChartWilayah" style="height:190px; gap:7px;">
      <% _topW.forEach(function(item) { %>
        <%
          var _wp  = Math.round((item.total / _maxW) * 100);
          var _wh  = item.total > 0 ? Math.max(_wp, 4) : 3;
          var _ns  = (item.wilayah || '-').replace(/^(PROVINSI |PROV\. |KABUPATEN |KOTA |KEC\. )/i, '');
        %>
        <div class="bar-col">
          <div class="bar-fill-w" style="height:<%= _wh + '%' %>;">
            <span class="bar-tooltip"><%= item.wilayah || '-' %> — <%= item.total.toLocaleString('id-ID') %> pohon</span>
          </div>
          <span class="bar-label" style="font-size:.53rem;white-space:nowrap;overflow:hidden;max-width:100%;text-overflow:ellipsis;">
            <%= _ns.length > 9 ? _ns.slice(0,8) + '…' : _ns %>
          </span>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- ═══ BOTTOM ROW ═══ -->
<div class="section-label">Peringkat &amp; Status</div>
<div class="bottom-row">

  <!-- Top 5 Corporate -->
  <div class="card">
    <div class="card-title">Top 5 Donatur Corporate</div>
    <div class="card-sub">Berdasarkan jumlah pohon</div>
    <% if (!topCorporate || topCorporate.length === 0) { %>
      <div class="empty-state">Belum ada data.</div>
    <% } else { %>
      <%
        var _maxPC   = Math.max.apply(null, topCorporate.map(function(c){ return Number(c.dataValues ? c.dataValues.total_pohon : 0); }).concat([1]));
        var _rankCls = ['gold','silver','bronze','',''];
      %>
      <div class="corp-list">
        <% topCorporate.forEach(function(corp, idx) { %>
          <%
            var _cp  = Number(corp.dataValues ? corp.dataValues.total_pohon : 0);
            var _cbp = Math.round((_cp / _maxPC) * 100);
            var _cn  = corp.user ? corp.user.nama_lengkap : '-';
          %>
          <div class="corp-item">
            <div class="corp-rank <%= _rankCls[idx] %>"><%= idx + 1 %></div>
            <div class="corp-info">
              <div class="corp-name"><%= _cn %></div>
              <div class="corp-bar-wrap"><div class="corp-bar" style="width:<%= _cbp + '%' %>"></div></div>
            </div>
            <div class="corp-pohon"><%= _cp.toLocaleString('id-ID') %></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Top 5 Program -->
  <div class="card">
    <div class="card-title">Top 5 Program</div>
    <div class="card-sub">Berdasarkan pohon terkumpul</div>
    <% if (!topProgram || topProgram.length === 0) { %>
      <div class="empty-state">Belum ada data.</div>
    <% } else { %>
      <div class="prog-list">
        <% topProgram.forEach(function(prog) { %>
          <%
            var _pn  = prog.program ? prog.program.judul_program : '-';
            var _pp  = Number(prog.dataValues ? prog.dataValues.total_pohon  : 0);
            var _pd  = Number(prog.dataValues ? prog.dataValues.total_donasi : 0);
            var _pdr = _pd >= 1e6 ? ((_pd/1e6).toFixed(1) + ' Jt') : _pd.toLocaleString('id-ID');
          %>
          <div class="prog-item">
            <div class="prog-title" title="<%= _pn %>"><%= _pn %></div>
            <div class="prog-meta">
              <span class="prog-stat">
                <svg class="icon-tree" width="9" height="9" viewBox="0 0 64 64" fill="var(--green-bright)"><polygon points="32,4 44,22 38,22 50,40 41,40 54,58 10,58 23,40 14,40 26,22 20,22"/></svg>
                <strong><%= _pp.toLocaleString('id-ID') %></strong> pohon
              </span>
              <span class="prog-stat rp"><strong>Rp <%= _pdr %></strong></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Status Program — Pie Chart -->
  <div class="card">
    <div class="card-title">Status Program</div>
    <div class="card-sub">Distribusi status seluruh program</div>
    <% if (!statusProgramChart || statusProgramChart.length === 0) { %>
      <div class="empty-state">Belum ada data.</div>
    <% } else { %>
      <%
        var _pieColors = { aktif: '#40916c', selesai: '#74a8b8', nonaktif: '#d97575' };
        var _pieTotal  = statusProgramChart.reduce(function(s,x){ return s + Number(x.dataValues ? x.dataValues.total : x.total || 0); }, 0) || 1;
        /* Hitung slice data */
        var _slices = statusProgramChart.map(function(sp) {
          var _cnt = Number(sp.dataValues ? sp.dataValues.total : sp.total || 0);
          return {
            label: sp.status_program,
            count: _cnt,
            pct:   (_cnt / _pieTotal) * 100,
            color: _pieColors[sp.status_program] || '#aaaaaa'
          };
        });
      %>
      <div class="pie-wrap">
        <div class="pie-svg-wrap">
          <svg viewBox="-1 -1 2 2" width="130" height="130" style="transform:rotate(-90deg);">
            <%
              var _pieOff = 0;
              _slices.forEach(function(sl) {
                var _pRad  = (sl.pct / 100) * Math.PI * 2;
                var _x1    = Math.cos(_pieOff);
                var _y1    = Math.sin(_pieOff);
                _pieOff   += _pRad;
                var _x2    = Math.cos(_pieOff);
                var _y2    = Math.sin(_pieOff);
                var _large = sl.pct > 50 ? 1 : 0;
            %>
              <path d="M 0 0 L <%= _x1.toFixed(5) %> <%= _y1.toFixed(5) %> A 1 1 0 <%= _large %> 1 <%= _x2.toFixed(5) %> <%= _y2.toFixed(5) %> Z"
                fill="<%= sl.color %>"/>
            <% }) %>
            <!-- Lubang tengah donut -->
            <circle cx="0" cy="0" r="0.55" fill="var(--surface)"/>
          </svg>
          <!-- Label total di tengah -->
          <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
            <span style="font-family:var(--font-num);font-size:1.1rem;font-weight:700;color:var(--ink);line-height:1;"><%= _pieTotal.toLocaleString('id-ID') %></span>
            <span style="font-size:.58rem;color:var(--ink-soft);">Program</span>
          </div>
        </div>
        <div class="pie-legend">
          <% _slices.forEach(function(sl) { %>
            <div class="pie-leg-item">
              <div class="pie-leg-dot" style="background:<%= sl.color %>;"></div>
              <div class="pie-leg-info">
                <div class="pie-leg-label"><%= sl.label %></div>
                <div style="display:flex;align-items:baseline;gap:5px;">
                  <span class="pie-leg-count"><%= sl.count.toLocaleString('id-ID') %></span>
                  <span class="pie-leg-pct"><%= sl.pct.toFixed(1) %>%</span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

</div>

<script>
  /* ─── Format Rupiah ─── */
  function formatRupiah(n) {
    if (n >= 1e9) { var m = n/1e9; return 'Rp ' + (Number.isInteger(m)?m.toLocaleString('id-ID'):m.toFixed(2).replace(/\.?0+$/,'').replace('.',',')) + ' M'; }
    if (n >= 1e6) { var j = n/1e6; return 'Rp ' + (Number.isInteger(j)?j.toLocaleString('id-ID'):j.toFixed(2).replace(/\.?0+$/,'').replace('.',',')) + ' Jt'; }
    if (n >= 1e3) { var r = n/1e3; return 'Rp ' + (Number.isInteger(r)?r.toLocaleString('id-ID'):r.toFixed(2).replace(/\.?0+$/,'').replace('.',',')) + ' Rb'; }
    return 'Rp ' + n.toLocaleString('id-ID');
  }

  /* ─── Isi tooltip donasi ─── */
  document.querySelectorAll('#barChartDonasi .bar-tooltip[data-value]').forEach(function(el) {
    el.textContent = formatRupiah(Number(el.dataset.value));
  });

  /* ─── Tahun Picker ─── */
  var TAHUN_NOW   = new Date().getFullYear();
  var TAHUN_AKTIF = parseInt('<%= tahun %>');
  var TAHUN_AWAL  = 2022;

  function buildTahunDropdown() {
    var dd = document.getElementById('tahunDropdown');
    dd.innerHTML = '';
    for (var y = TAHUN_NOW; y >= TAHUN_AWAL; y--) {
      var el = document.createElement('div');
      el.className = 'tahun-option' + (y === TAHUN_AKTIF ? ' active' : '');
      el.textContent = y;
      (function(yr){ el.onclick = function(){ pilihTahun(yr); }; })(y);
      dd.appendChild(el);
    }
  }
  function toggleTahunDropdown() { document.getElementById('tahunWrap').classList.toggle('open'); }
  function pilihTahun(y) {
    document.getElementById('tahunLabel').textContent = y;
    document.getElementById('tahunInput').value = y;
    document.getElementById('tahunWrap').classList.remove('open');
    document.getElementById('tahunForm').submit();
  }
  document.addEventListener('click', function(e) {
    var w = document.getElementById('tahunWrap');
    if (w && !w.contains(e.target)) w.classList.remove('open');
  });
  buildTahunDropdown();

  /* ─── Animate bars ─── */
  (function() {
    document.querySelectorAll('#barChartDonasi .bar-fill:not(.zero)').forEach(function(bar, i) {
      var h = bar.style.height; bar.style.height = '3px';
      setTimeout(function(){ bar.style.height = h; }, 60 + i*35);
    });
    document.querySelectorAll('#barChartWilayah .bar-fill-w').forEach(function(bar, i) {
      var h = bar.style.height; bar.style.height = '3px';
      setTimeout(function(){ bar.style.height = h; }, 80 + i*45);
    });
  })();
  /* ─── Filter Wilayah Popup ─── */
  function openFwPopup() {
    document.getElementById('fwOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeFwPopup() {
    document.getElementById('fwOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }
  function handleFwOverlay(e) {
    if (e.target === document.getElementById('fwOverlay')) closeFwPopup();
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeFwPopup();
  });

  /* ─── Cascade Dropdown Wilayah ─── */
  /* Pola sama dengan admin pusat: tidak fetch ajax,
     tapi submit form preview dulu agar controller reload data wilayah */
  (function() {
    var selProv = document.getElementById('fwProvinsi');
    var selKota = document.getElementById('fwKota');
    var selKec  = document.getElementById('fwKecamatan');
    var selKel  = document.getElementById('fwKelurahan');
    var form    = document.getElementById('fwForm');

    function resetSel(sel, ph) {
      sel.innerHTML = '<option value="">' + ph + '</option>';
      sel.disabled = true;
    }

    /* Saat provinsi berubah — clear bawahnya, submit form
       agar controller reload regencies untuk provinsi yang dipilih */
    selProv.addEventListener('change', function() {
      resetSel(selKota, 'Semua Kab/Kota');
      resetSel(selKec,  'Semua Kecamatan');
      resetSel(selKel,  'Semua Kelurahan');
      /* Kosongkan field bawah agar tidak ikut tersubmit */
      selKota.name = '';
      selKec.name  = '';
      selKel.name  = '';
      if (this.value) form.submit();
    });

    selKota.addEventListener('change', function() {
      resetSel(selKec, 'Semua Kecamatan');
      resetSel(selKel, 'Semua Kelurahan');
      selKec.name = '';
      selKel.name = '';
      if (this.value) form.submit();
    });

    selKec.addEventListener('change', function() {
      resetSel(selKel, 'Semua Kelurahan');
      selKel.name = '';
      if (this.value) form.submit();
    });

    /* Aktifkan select yang sudah punya data dari server (page load dengan filter aktif) */
    <% var _rcnt = _regencies.length; var _dcnt = _districts.length; var _vcnt = _villages.length; %>
    if (<%= _rcnt %> > 0) selKota.disabled = false;
    if (<%= _dcnt %> > 0) selKec.disabled  = false;
    if (<%= _vcnt %> > 0) selKel.disabled  = false;
  })();
</script>
