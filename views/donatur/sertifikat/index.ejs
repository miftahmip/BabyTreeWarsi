<% layout('layouts/donatur') %>

<!-- views/donatur/sertifikat/index.ejs -->

<style>
  .sert-page {
    /* --green-*, --brown-*, --cream sudah didefinisikan global di layouts/donatur.ejs,
       di sini cuma tambah variabel yang belum ada di :root layout */
    --white:        #ffffff;
    --text-dark:    #1a2e22;
    --text-muted:   #6b8f78;

    background: var(--cream);
    min-height: 100vh;
    padding: 40px 24px 80px;
    font-family: 'DM Sans', sans-serif;
    color: var(--text-dark);
  }

  .sert-header {
    max-width: 960px;
    margin: 0 auto 32px;
  }

  .sert-header h1 {
    font-size: 28px;
    color: var(--green-deep);
    margin: 0 0 6px;
    font-weight: 700;
  }

  .sert-header p {
    color: var(--text-muted);
    margin: 0;
    font-size: 15px;
  }

  .sert-list {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sert-card {
    background: var(--white);
    border: 1px solid var(--green-pale);
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .sert-card:hover {
    box-shadow: 0 4px 16px rgba(26, 71, 49, 0.08);
    transform: translateY(-1px);
  }

  .sert-card-info h3 {
    margin: 0 0 4px;
    font-size: 17px;
    color: var(--green-deep);
    font-weight: 600;
  }

  .sert-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .sert-badge.klaim {
    background: var(--green-pale);
    color: var(--green-deep);
  }

  .sert-badge.belum {
    background: var(--cream);
    color: var(--brown-mid);
    border: 1px solid var(--brown-light);
  }

  .sert-actions a,
  .sert-actions button {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-klaim {
    background: var(--green-mid);
    color: var(--white);
  }
  .btn-klaim:hover { background: var(--green-deep); }

  .btn-lihat {
    background: var(--white);
    color: var(--green-mid);
    border: 1.5px solid var(--green-mid) !important;
  }
  .btn-lihat:hover { background: var(--green-ghost); }

  .sert-empty {
    max-width: 960px;
    margin: 60px auto 0;
    text-align: center;
    color: var(--text-muted);
  }

  .sert-empty h3 {
    color: var(--green-deep);
    margin-bottom: 6px;
  }

  @media (max-width: 600px) {
    .sert-card { flex-direction: column; align-items: flex-start; }
    .sert-actions { width: 100%; }
    .sert-actions a, .sert-actions button { width: 100%; text-align: center; }
  }
</style>

<div class="sert-page">
  <div class="sert-header">
    <h1>Sertifikat Donasi Saya</h1>
    <p>Klaim sertifikat untuk program yang penanamannya sudah berjalan dan programnya telah selesai.</p>
  </div>

  <% if (programList && programList.length > 0) { %>
    <div class="sert-list">
      <% programList.forEach(function(item) { %>
        <div class="sert-card">
          <div class="sert-card-info">
            <h3><%= item.judul_program %></h3>
            <% if (item.sudah_diklaim) { %>
              <span class="sert-badge klaim">✓ Sudah diklaim</span>
            <% } else { %>
              <span class="sert-badge belum">Siap diklaim</span>
            <% } %>
          </div>
          <div class="sert-actions">
            <% if (item.sudah_diklaim) { %>
              <a class="btn-lihat" href="/donatur/sertifikat/<%= item.id_sertifikat %>">Lihat Sertifikat</a>
            <% } else { %>
              <form method="POST" action="/donatur/sertifikat/klaim/<%= item.id_program %>">
                <button type="submit" class="btn-klaim">Klaim Sertifikat</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="sert-empty">
      <h3>Belum ada sertifikat yang bisa diklaim</h3>
      <p>Sertifikat akan muncul di sini setelah program donasi Anda selesai dan pohonnya sudah masuk tahap penanaman.</p>
    </div>
  <% } %>
</div>
