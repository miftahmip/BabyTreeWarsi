<% layout('layouts/donatur') %>

<!-- views/donatur/sertifikat/detail.ejs -->

<style>
  .sertd-page {
    /* --green-*, --brown-*, --cream sudah didefinisikan global di layouts/donatur.ejs */
    --white:        #ffffff;
    --text-dark:    #1a2e22;
    --text-muted:   #6b8f78;

    background: var(--cream);
    min-height: 100vh;
    padding: 40px 24px 80px;
    font-family: 'DM Sans', sans-serif;
    color: var(--text-dark);
  }

  .sertd-wrap {
    max-width: 820px;
    margin: 0 auto;
  }

  .sertd-back {
    display: inline-block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 20px;
  }
  .sertd-back:hover { color: var(--green-deep); }

  /* Kartu sertifikat - meniru layout PDF (border ganda, tipografi tengah) */
  .sertd-certificate {
    background: #fff;
    border: 3px solid var(--green-deep);
    border-radius: 4px;
    padding: 56px 48px;
    position: relative;
    text-align: center;
  }

  .sertd-certificate::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid var(--green-mid);
    border-radius: 2px;
    pointer-events: none;
  }

  .sertd-logo {
    height: 56px;
    margin: 0 auto 16px;
    display: block;
  }

  .sertd-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--green-deep);
    letter-spacing: 1px;
    margin: 0 0 8px;
  }

  .sertd-no {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 32px;
  }

  .sertd-label {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 0 6px;
  }

  .sertd-nama {
    font-size: 24px;
    font-weight: 700;
    color: var(--green-mid);
    margin: 0 0 24px;
    text-align: center;
  }

  .sertd-deskripsi {
    font-size: 15px;
    color: var(--text-dark);
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto 8px;
  }

  .sertd-program {
    font-size: 17px;
    font-weight: 700;
    color: var(--brown-mid);
    margin: 0 0 24px;
  }

  .sertd-tanggal {
    font-size: 13px;
    color: var(--text-muted);
    margin: 32px 0 12px;
  }

  .sertd-ttd-block {
    display: inline-block;
    text-align: center;
  }

  .sertd-ttd-img {
    height: 160px;
    margin-bottom: -20px;
  }

  .sertd-ttd-line {
    width: 180px;
    border-top: 1px solid var(--text-dark);
    margin: 0px auto 6px;
  }

  .sertd-ttd-nama {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0;
  }

  .sertd-ttd-jabatan {
    font-size: 12.5px;
    color: var(--text-muted);
    margin: 2px 0 0;
  }

  .sertd-status {
    display: inline-block;
    margin-top: 24px;
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--green-pale);
    color: var(--green-deep);
    font-weight: 600;
  }

  .sertd-status.dicabut {
    background: #fde8e8;
    color: #b3261e;
  }

  .sertd-download {
    display: block;
    text-align: center;
    margin-top: 28px;
  }

  .sertd-download a {
    display: inline-block;
    background: var(--green-mid);
    color: var(--white);
    padding: 12px 32px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: background 0.15s ease;
  }

  .sertd-download a:hover {
    background: var(--green-deep);
  }

  @media (max-width: 600px) {
    .sertd-certificate { padding: 36px 20px; }
    .sertd-title { font-size: 20px; }
    .sertd-nama { font-size: 19px; }
  }
</style>

<div class="sertd-page">
  <div class="sertd-wrap">
    <a class="sertd-back" href="/donatur/sertifikat">&larr; Kembali ke daftar sertifikat</a>

    <div class="sertd-certificate">
      <img class="sertd-logo" src="/images/warsi_logo.png" alt="Logo KKI Warsi" />

      <p class="sertd-title">SERTIFIKAT DONASI POHON</p>
      <p class="sertd-no">No. <%= sertifikat.no_sertifikat %></p>

      <p class="sertd-label">Dengan bangga diberikan kepada</p>
      <p class="sertd-nama"><%= user.nama_lengkap %></p>

      <p class="sertd-deskripsi">
        Atas kontribusinya menyumbangkan
        <strong><%= sertifikat.total_pohon_akumulasi %> pohon</strong>
        pada program
      </p>
      <p class="sertd-program">"<%= programJudul %>"</p>

      <p class="sertd-tanggal">
        Diterbitkan pada
        <%= new Date(sertifikat.tgl_terbit).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
      </p>

      <div class="sertd-ttd-block">
        <% if (sertifikat.penandatangan && sertifikat.penandatangan.ttd_file) { %>
          <img class="sertd-ttd-img" src="/uploads/<%= sertifikat.penandatangan.ttd_file %>" alt="Tanda tangan" />
        <% } %>
        <div class="sertd-ttd-line"></div>
        <p class="sertd-ttd-nama"><%= sertifikat.penandatangan.user.nama_lengkap %></p>
      <p class="sertd-ttd-jabatan"><%= sertifikat.penandatangan.jabatan %></p>
            </div>

            <% if (sertifikat.status_sertifikat === 'dicabut') { %>
              <div>
                <span class="sertd-status dicabut">Dicabut</span>
              </div>
            <% } %>
          </div>
    </div>

    <% if (sertifikat.url_sertifikat) { %>
      <div class="sertd-download">
        <a href="/donatur/sertifikat/<%= sertifikat.id_sertifikat %>/download">Unduh PDF</a>
      </div>
    <% } %>
  </div>
</div>