<% layout('layouts/donatur') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap');

  .ds-wrap {
    padding: 28px 8px 48px 0;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Page header ── */
  .ds-page-header {
    margin-bottom: 32px;
  }

  .ds-page-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a4731;
    margin: 0 0 5px;
    line-height: 1.2;
  }

  .ds-page-header p {
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    color: #7c9585;
    margin: 0;
    font-weight: 300;
  }

  /* ── Grid ── */
  .ds-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 960px) {
    .ds-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .ds-grid { grid-template-columns: 1fr; gap: 14px; }
    .ds-page-header h2 { font-size: 1.4rem; }
    .ds-wrap { padding: 20px 14px 40px; }
  }

  /* ── Card ── */
  .ds-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid rgba(116,198,157,.18);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .22s cubic-bezier(.22,1,.36,1),
                box-shadow .22s cubic-bezier(.22,1,.36,1);
    box-shadow: 0 2px 12px rgba(26,71,49,.06);
    position: relative;
  }

  .ds-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(26,71,49,.13);
  }

  /* Accent stripe top */
  .ds-card::before {
    content: '';
    display: block;
    height: 4px;
    background: linear-gradient(90deg, #40916c, #74c69d);
    width: 100%;
  }

  /* ── Card body ── */
  .ds-card-body {
    padding: 20px 20px 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Program icon badge */
  .ds-icon-wrap {
    width: 42px; height: 42px;
    border-radius: 12px;
    background: rgba(216,243,220,.5);
    border: 1px solid rgba(116,198,157,.25);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
    flex-shrink: 0;
  }

  .ds-program-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 600;
    color: #1a4731;
    line-height: 1.35;
    margin: 0 0 14px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Pohon badge */
  .ds-pohon-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(216,243,220,.45);
    border: 1px solid rgba(116,198,157,.25);
    border-radius: 30px;
    padding: 6px 13px 6px 8px;
    margin-bottom: 18px;
    width: fit-content;
  }

  .ds-pohon-badge-dot {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: linear-gradient(135deg, #52b788, #2d6a4f);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .ds-pohon-count {
    font-family: 'DM Sans', sans-serif;
    font-size: .82rem;
    color: #1a4731;
    font-weight: 600;
  }

  .ds-pohon-count span {
    font-weight: 700;
    font-size: .92rem;
  }

  /* ── Card footer ── */
  .ds-card-footer {
    padding: 12px 20px 18px;
  }

  .ds-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: 100%;
    padding: 11px 16px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    background: linear-gradient(135deg, #40916c, #1a4731);
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: .86rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: .2px;
    transition: opacity .18s, transform .18s;
    box-shadow: 0 4px 14px rgba(45,106,79,.28);
  }

  .ds-btn:hover {
    opacity: .92;
    transform: translateY(-1px);
    color: #fff;
    text-decoration: none;
  }

  /* ── Empty state ── */
  .ds-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 64px 24px;
    background: #fff;
    border: 1px dashed rgba(116,198,157,.35);
    border-radius: 18px;
  }

  .ds-empty-icon {
    width: 60px; height: 60px;
    border-radius: 50%;
    background: rgba(216,243,220,.4);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
  }

  .ds-empty h4 {
    font-family: 'Playfair Display', serif;
    color: #1a4731;
    font-size: 1.1rem;
    margin: 0 0 6px;
  }

  .ds-empty p {
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    color: #7c9585;
    margin: 0;
  }

  /* Card entry animation */
  .ds-card {
    animation: cardIn .4s cubic-bezier(.22,1,.36,1) both;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

    .ds-card:nth-child(1) { animation-delay: 0s; }
    .ds-card:nth-child(2) { animation-delay: .07s; }
    .ds-card:nth-child(3) { animation-delay: .14s; }
    .ds-card:nth-child(4) { animation-delay: .21s; }
    .ds-card:nth-child(5) { animation-delay: .28s; }
    .ds-card:nth-child(6) { animation-delay: .35s; }
</style>


<div class="ds-wrap">

  <!-- Header -->
  <div class="ds-page-header">
    <h2>Donasi Saya</h2>
    <p>Program donasi yang sedang atau telah kamu ikuti</p>
  </div>

  <!-- Grid -->
  <div class="ds-grid">

    <% if (!data || data.length === 0) { %>
    <div class="ds-empty">
      <div class="ds-empty-icon">
        <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="#40916c" stroke-width="1.5">
          <path d="M12 22V12" stroke-linecap="round"/>
          <path d="M12 12C12 12 8 9 8 5C8 2.5 10 1 12 1C14 1 16 2.5 16 5C16 9 12 12 12 12Z"/>
        </svg>
      </div>
      <h4>Belum Ada Donasi</h4>
      <p>Kamu belum memiliki program donasi aktif saat ini</p>
    </div>
    <% } %>

    <% if (data && data.length > 0) { %>
      <% data.forEach(item => { %>
      <div class="ds-card">
        <div class="ds-card-body">


          <!-- Judul -->
          <h3 class="ds-program-title">
            <%= item.program.judul_program %>
          </h3>

          <!-- Jumlah pohon -->
          <div class="ds-pohon-badge">
            <div class="ds-pohon-badge-dot">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="1.8">
          <!-- Lapisan atas (puncak cemara) -->
          <polygon points="12,2 7,9 17,9" stroke-linejoin="round"></polygon>
          <!-- Lapisan tengah (badan cemara) -->
          <polygon points="12,6 5.5,14 18.5,14" stroke-linejoin="round"></polygon>
          <!-- Lapisan bawah (rok cemara) -->
          <polygon points="12,10 4,20 20,20" stroke-linejoin="round"></polygon>
          <!-- Batang -->
          <line x1="12" y1="20" x2="12" y2="22" stroke-linecap="round"></line>
        </svg>
            </div>
            <span class="ds-pohon-count">
              <span><%= item.dataValues.total_pohon %></span> Pohon Didonasikan
            </span>
          </div>

        </div>

        <!-- Button -->
        <div class="ds-card-footer">
          <a href="/donatur/dashboard-program/<%= item.program.id_program %>"
             class="ds-btn">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <rect x="3" y="3" width="7" height="7" rx="1"/>
              <rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/>
              <rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Lihat Dashboard
          </a>
        </div>
      </div>
      <% }) %>
    <% } %>

  </div>
</div>
