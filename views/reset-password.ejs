<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - BabyTreeWarsi</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --green-deep:   #1a4731;
      --green-mid:    #2d6a4f;
      --green-bright: #40916c;
      --green-light:  #74c69d;
      --green-pale:   #d8f3dc;
      --green-ghost:  #f0faf4;
      --brown-mid:    #7d5a3c;
      --cream:        #fdf8f0;
    }

    body {
      min-height: 100vh;
      background: var(--green-ghost);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      font-family: 'Segoe UI', Arial, sans-serif;
    }

    /* ── Card ─────────────────────────────── */
    .card {
      background: #fff;
      border-radius: 20px;
      padding: 2.25rem 2rem;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 8px 32px rgba(26,71,49,.1);
      border: 1px solid var(--green-pale);
    }

    /* ── Brand ────────────────────────────── */
    .brand {
      text-align: center;
      margin-bottom: 1.75rem;
    }

    .brand-icon {
      width: 56px;
      height: 56px;
      background: var(--green-pale);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto .75rem;
    }

    .brand-icon svg { color: var(--green-mid); }

    .brand h1 {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--green-deep);
      margin-bottom: .25rem;
    }

    .brand p {
      font-size: .85rem;
      color: #888;
      line-height: 1.5;
    }

    /* ── Alert ────────────────────────────── */
    .alert {
      display: flex;
      align-items: flex-start;
      gap: .6rem;
      padding: .8rem 1rem;
      border-radius: 10px;
      font-size: .85rem;
      font-weight: 500;
      margin-bottom: 1.25rem;
      line-height: 1.5;
    }

    .alert-error {
      background: #fff0f0;
      color: #8b1a1a;
      border: 1px solid #f5a5a5;
    }

    .alert svg { flex-shrink: 0; width: 17px; height: 17px; margin-top: 1px; }

    /* ── Form ─────────────────────────────── */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: .4rem;
      margin-bottom: 1.1rem;
    }

    .form-group label {
      font-size: .8rem;
      font-weight: 600;
      color: var(--green-mid);
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .input-wrap {
      position: relative;
    }

    .form-group input {
      padding: .7rem 2.75rem .7rem .95rem;
      border: 1.5px solid var(--green-pale);
      border-radius: 10px;
      font-size: .9rem;
      color: var(--green-deep);
      outline: none;
      transition: border-color .2s, box-shadow .2s;
      width: 100%;
    }

    .form-group input:focus {
      border-color: var(--green-bright);
      box-shadow: 0 0 0 3px rgba(64,145,108,.12);
    }

    .form-group input::placeholder { color: #bbb; }

    /* Toggle show/hide password */
    .btn-eye {
      position: absolute;
      right: .75rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #aaa;
      padding: 0;
      display: flex;
      align-items: center;
      transition: color .2s;
    }

    .btn-eye:hover { color: var(--green-mid); }

    /* ── Hint kekuatan password ───────────── */
    .password-hint {
      font-size: .78rem;
      color: #999;
      margin-top: .3rem;
    }

    /* ── Tombol submit ────────────────────── */
    .btn-submit {
      width: 100%;
      padding: .85rem;
      background: var(--green-mid);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: .95rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      transition: background .2s, transform .1s;
      letter-spacing: .02em;
      margin-top: 1.5rem;
      margin-bottom: 1.25rem;
    }

    .btn-submit:hover  { background: var(--green-bright); }
    .btn-submit:active { transform: scale(.98); }

    /* ── Link kembali ─────────────────────── */
    .back-link {
      text-align: center;
      font-size: .85rem;
      color: #888;
    }

    .back-link a {
      color: var(--green-mid);
      font-weight: 600;
      text-decoration: none;
    }

    .back-link a:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <div class="card">

    <!-- Brand -->
    <div class="brand">
      <div class="brand-icon">
        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
      </div>
      <h1>Buat Password Baru</h1>
      <p>Masukkan password baru Anda.<br>Pastikan minimal 6 karakter.</p>
    </div>

    <!-- Alert error -->
    <% if (error) { %>
      <div class="alert alert-error">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
        </svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/reset-password" method="POST">

      <!-- Token tersembunyi -->
      <input type="hidden" name="token" value="<%= token %>">

      <div class="form-group">
        <label>Password Baru</label>
        <div class="input-wrap">
          <input
            type="password"
            name="password_baru"
            id="password_baru"
            placeholder="Minimal 6 karakter"
            required
            oninput="checkMatch()">
          <button type="button" class="btn-eye" onclick="toggleEye('password_baru', 'eye1')">
            <svg id="eye1" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
            </svg>
          </button>
        </div>
        <span class="password-hint">Gunakan kombinasi huruf dan angka untuk keamanan lebih baik.</span>
      </div>

      <div class="form-group">
        <label>Konfirmasi Password</label>
        <div class="input-wrap">
          <input
            type="password"
            name="konfirmasi_password"
            id="konfirmasi_password"
            placeholder="Ulangi password baru"
            required
            oninput="checkMatch()">
          <button type="button" class="btn-eye" onclick="toggleEye('konfirmasi_password', 'eye2')">
            <svg id="eye2" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
            </svg>
          </button>
        </div>
        <span class="password-hint" id="matchHint"></span>
      </div>

      <button type="submit" class="btn-submit" id="btnSubmit">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
        </svg>
        Simpan Password Baru
      </button>

    </form>

    <div class="back-link">
      <a href="/login">← Kembali ke Login</a>
    </div>

  </div>

  <script>
    // Toggle show/hide password
    function toggleEye(inputId, eyeId) {
      const input = document.getElementById(inputId);
      input.type  = input.type === 'password' ? 'text' : 'password';
    }

    // Cek kecocokan password real-time
    function checkMatch() {
      const pw1   = document.getElementById('password_baru').value;
      const pw2   = document.getElementById('konfirmasi_password').value;
      const hint  = document.getElementById('matchHint');
      const btn   = document.getElementById('btnSubmit');

      if (!pw2) {
        hint.textContent = '';
        hint.style.color = '#999';
        btn.disabled = false;
        return;
      }

      if (pw1 === pw2) {
        hint.textContent = '✓ Password cocok';
        hint.style.color = '#2d6a4f';
        btn.disabled = false;
      } else {
        hint.textContent = '✗ Password tidak cocok';
        hint.style.color = '#8b1a1a';
        btn.disabled = true;
      }
    }
  </script>

</body>
</html>
