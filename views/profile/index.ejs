<%
  const layoutMap = {
    admin_pusat:       'layouts/admin-pusat',
    admin_wilayah:     'layouts/admin-wilayah',
    petugas_lapangan:  'layouts/petugas',
    donatur_umum:      'layouts/donatur',
    donatur_corporate: 'layouts/donatur',
    pimpinan:          'layouts/pimpinan',
  };
  layout(layoutMap[user.role] || 'layouts/main');
%>

<style>
  :root {
    --green-deep:   #1a4731;
    --green-mid:    #2d6a4f;
    --green-bright: #40916c;
    --green-light:  #74c69d;
    --green-pale:   #d8f3dc;
    --green-ghost:  #f0faf4;
    --brown-mid:    #7d5a3c;
    --cream:        #fdf8f0;
  }

  /* ── Layout ───────────────────────────────── */
  .profile-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.75rem 1.25rem 3rem;
  }

  /* ── Header ───────────────────────────────── */
  .profile-hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .profile-avatar-lg {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--green-mid);
    color: #fff;
    font-size: 1.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    letter-spacing: .02em;
    box-shadow: 0 4px 14px rgba(26,71,49,.2);
  }

  .profile-hero-info h1 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--green-deep);
    margin: 0 0 .25rem;
  }

  .role-badge {
    display: inline-block;
    padding: .25rem .75rem;
    border-radius: 20px;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    background: var(--green-pale);
    color: var(--green-mid);
    border: 1px solid var(--green-light);
  }

  /* ── Alert ────────────────────────────────── */
  .alert {
    display: flex;
    align-items: center;
    gap: .65rem;
    padding: .8rem 1rem;
    border-radius: 10px;
    font-size: .875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background: var(--green-pale);
    color: var(--green-deep);
    border: 1px solid var(--green-light);
  }

  .alert-error {
    background: #fff0f0;
    color: #8b1a1a;
    border: 1px solid #f5a5a5;
  }

  .alert svg { flex-shrink: 0; width: 18px; height: 18px; }

  /* ── Card ─────────────────────────────────── */
  .profile-card {
    background: #fff;
    border: 1px solid var(--green-pale);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    box-shadow: 0 2px 12px rgba(26,71,49,.06);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: .65rem;
    padding: 1rem 1.25rem;
    background: var(--green-ghost);
    border-bottom: 1px solid var(--green-pale);
  }

  .card-header svg {
    color: var(--green-mid);
    flex-shrink: 0;
  }

  .card-header h2 {
    font-size: .95rem;
    font-weight: 700;
    color: var(--green-deep);
    margin: 0;
  }

  .card-body {
    padding: 1.25rem;
  }

  /* ── Form grid ────────────────────────────── */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }

  .form-group.full {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-size: .8rem;
    font-weight: 600;
    color: var(--green-mid);
    letter-spacing: .03em;
    text-transform: uppercase;
  }

  .form-group input {
    padding: .65rem .9rem;
    border: 1.5px solid var(--green-pale);
    border-radius: 10px;
    font-size: .9rem;
    color: var(--green-deep);
    background: #fff;
    transition: border-color .2s, box-shadow .2s;
    outline: none;
    width: 100%;
    box-sizing: border-box;
  }

  .form-group input:focus {
    border-color: var(--green-bright);
    box-shadow: 0 0 0 3px rgba(64,145,108,.12);
  }

  .form-group input:read-only {
    background: var(--green-ghost);
    color: var(--green-mid);
    cursor: default;
    border-color: var(--green-pale);
  }

  /* ── Info readonly (wilayah) ──────────────── */
  .info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .75rem 0;
    border-bottom: 1px solid var(--green-ghost);
  }

  .info-row:last-child { border-bottom: none; }

  .info-label {
    font-size: .8rem;
    font-weight: 600;
    color: var(--green-mid);
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .info-value {
    font-size: .9rem;
    color: var(--green-deep);
    font-weight: 500;
    text-align: right;
  }

  .info-note {
    font-size: .78rem;
    color: var(--brown-mid);
    margin-top: .65rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }

  /* ── Divider password ─────────────────────── */
  .password-toggle {
    display: flex;
    align-items: center;
    gap: .5rem;
    cursor: pointer;
    user-select: none;
    margin-bottom: 1rem;
  }

  .password-toggle input[type="checkbox"] { display: none; }

  .toggle-track {
    width: 36px;
    height: 20px;
    background: var(--green-pale);
    border-radius: 20px;
    position: relative;
    transition: background .2s;
    border: 1.5px solid var(--green-light);
    flex-shrink: 0;
  }

  .toggle-track::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    background: var(--green-mid);
    border-radius: 50%;
    top: 1px;
    left: 1px;
    transition: transform .2s;
  }

  .password-toggle input:checked ~ .toggle-track {
    background: var(--green-mid);
  }

  .password-toggle input:checked ~ .toggle-track::after {
    transform: translateX(16px);
    background: #fff;
  }

  .toggle-label {
    font-size: .875rem;
    font-weight: 600;
    color: var(--green-deep);
  }

  .password-fields {
    display: none;
  }

  .password-fields.visible {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  /* ── Submit ───────────────────────────────── */
  .btn-save {
    width: 100%;
    padding: .85rem;
    background: var(--green-mid);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: .95rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    margin-top: 1.25rem;
    transition: background .2s, transform .1s;
    letter-spacing: .02em;
  }

  .btn-save:hover  { background: var(--green-bright); }
  .btn-save:active { transform: scale(.98); }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 540px) {
    .form-grid        { grid-template-columns: 1fr; }
    .password-fields.visible { grid-template-columns: 1fr; }
    .profile-hero     { flex-direction: column; text-align: center; }
  }
</style>

<div class="profile-page">

  <%
    const roleLabel = {
      admin_pusat:       'Admin Pusat',
      admin_wilayah:     'Admin Wilayah',
      petugas_lapangan:  'Petugas Lapangan',
      donatur_umum:      'Donatur Umum',
      donatur_corporate: 'Donatur Corporate',
      pimpinan:          'Pimpinan',
    };

    const initials = user.nama_lengkap
      ? user.nama_lengkap.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
      : '??';
  %>

  <!-- Hero -->
  <div class="profile-hero">
    <div class="profile-avatar-lg"><%= initials %></div>
    <div class="profile-hero-info">
      <h1><%= user.nama_lengkap %></h1>
      <span class="role-badge"><%= roleLabel[user.role] || user.role %></span>
    </div>
  </div>

  <!-- Alert success / error -->
  <% if (success) { %>
    <div class="alert alert-success">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
      <%= success %>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
      </svg>
      <%= error %>
    </div>
  <% } %>

  <form action="/profile/update" method="POST">

    <!-- ── Card: Informasi Akun ── -->
    <div class="profile-card">
      <div class="card-header">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
        </svg>
        <h2>Informasi Akun</h2>
      </div>
      <div class="card-body">
        <div class="form-grid">

          <div class="form-group">
            <label>Nama Lengkap</label>
            <input type="text" name="nama_lengkap" value="<%= user.nama_lengkap %>" required>
          </div>

          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" value="<%= user.email %>" required>
          </div>

          <div class="form-group">
            <label>No. Telepon</label>
            <input type="text" name="no_telepon" value="<%= user.no_telepon || '' %>">
          </div>

          <div class="form-group">
            <label>Role</label>
            <input type="text" value="<%= roleLabel[user.role] || user.role %>" readonly>
          </div>

          <div class="form-group">
            <label>Status Akun</label>
            <input type="text" value="<%= user.status === 'aktif' ? 'Aktif' : 'Non-aktif' %>" readonly>
          </div>

        </div>
      </div>
    </div>

    <!-- ── Card: Wilayah (admin_wilayah saja) ── -->
    <% if (user.role === 'admin_wilayah') { %>
      <div class="profile-card">
        <div class="card-header">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
          </svg>
          <h2>Wilayah Tugas</h2>
        </div>
        <div class="card-body">
          <div class="info-row">
            <span class="info-label">Provinsi</span>
            <span class="info-value"><%= nama_provinsi || '-' %></span>
          </div>
          <p class="info-note">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
            </svg>
            Wilayah tugas hanya dapat diubah oleh Admin Pusat.
          </p>
        </div>
      </div>
    <% } %>

    <!-- ── Card: Keamanan ── -->
    <div class="profile-card">
      <div class="card-header">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
        </svg>
        <h2>Keamanan</h2>
      </div>
      <div class="card-body">

        <!-- Toggle ganti password -->
        <label class="password-toggle">
          <input type="checkbox" id="togglePassword" onchange="togglePasswordFields(this)">
          <span class="toggle-track"></span>
          <span class="toggle-label">Ganti Password</span>
        </label>

        <div class="password-fields" id="passwordFields">

          <div class="form-group full">
            <label>Password Lama</label>
            <input type="password" name="password_lama" id="password_lama" placeholder="Masukkan password saat ini">
          </div>

          <div class="form-group">
            <label>Password Baru</label>
            <input type="password" name="password_baru" id="password_baru" placeholder="Minimal 6 karakter">
          </div>

          <div class="form-group">
            <label>Konfirmasi Password</label>
            <input type="password" name="konfirmasi_password" id="konfirmasi_password" placeholder="Ulangi password baru">
          </div>

        </div>
      </div>
    </div>

    <button type="submit" class="btn-save">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z"/>
      </svg>
      Simpan Perubahan
    </button>

  </form>

</div>

<script>
  function togglePasswordFields(checkbox) {
    const fields = document.getElementById('passwordFields');
    fields.classList.toggle('visible', checkbox.checked);

    // Reset nilai saat disembunyikan
    if (!checkbox.checked) {
      document.getElementById('password_lama').value        = '';
      document.getElementById('password_baru').value        = '';
      document.getElementById('konfirmasi_password').value  = '';
    }
  }

  // Auto-dismiss alert setelah 4 detik
  document.querySelectorAll('.alert').forEach(el => {
    setTimeout(() => {
      el.style.transition = 'opacity .4s';
      el.style.opacity    = '0';
      setTimeout(() => el.remove(), 400);
    }, 4000);
  });
</script>
